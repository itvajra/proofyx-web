---
import BaseLayout from '../layouts/BaseLayout.astro';
import Newsletter from '../components/Newsletter.astro';

const pageTitle = "Compliance Insights Newsletter";
const pageDescription = "Join over 500+ compliance professionals. Practical guidance on CMMC, audit readiness, evidence tracking, and compliance operations delivered to your inbox.";
---

<BaseLayout 
  title={pageTitle}
  description={pageDescription}
  hideHeader={true}
  hideFooter={true}
>
  <div class="min-h-screen flex flex-col items-center justify-center py-12 px-4 sm:px-6 lg:px-8 bg-[#050810]">
    <!-- Brand Logo -->
    <div class="mb-12">
      <a href="/">
        <img src="/images/logo.png" alt="Proofyx" class="h-10 w-auto" />
      </a>
    </div>

    <!-- Centered Newsletter Content -->
    <div class="w-full max-w-6xl">
      <div class="bg-[#0a0f1d] rounded-3xl border border-white/5 shadow-2xl overflow-hidden">
        <Newsletter 
          heading="Compliance Insights" 
          subtext="Practical guidance on CMMC, audit readiness, evidence tracking, and compliance operations delivered to your inbox."
        />
      </div>
    </div>

    <!-- Secondary Links -->
    <div class="mt-12 text-center">
      <a href="/" class="text-white/40 hover:text-white transition-colors text-sm flex items-center justify-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        Back to Proofyx Home
      </a>
    </div>
    
    <div class="mt-8 text-center text-white/20 text-xs">
      © {new Date().getFullYear()} Proofyx. A product of <a href="https://itvajra.com" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors underline decoration-white/10 underline-offset-2">IT Vajra</a>. All rights reserved.
    </div>
  </div>
</BaseLayout>

<style>
  /* Override the newsletter component padding for the landing page */
  :global(.newsletter-section) {
    padding: 4rem 2rem !important;
    background: transparent !important;
  }
  
  :global(.newsletter-glow-top), :global(.newsletter-glow-bottom) {
    display: none !important;
  }
</style>
