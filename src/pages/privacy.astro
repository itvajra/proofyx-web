---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTASection from '../components/CTASection.astro';
---
<BaseLayout title="Privacy Policy">
  <section class="py-24 bg-white">
    <div class="container mx-auto px-6 max-w-3xl">
      <h1 class="text-4xl font-bold mb-8">Privacy Policy</h1>
      <p class="text-neutral-500 mb-8 uppercase tracking-widest text-xs font-bold">Last Updated: May 2026</p>
      <div class="prose max-w-none">
        <p>Proofyx is committed to protecting your privacy. This policy outlines how we handle your data.</p>
        <h2>Data Collection</h2>
        <p>We collect minimal data necessary to provide our compliance and policy management services.</p>
        <h2>Data Security</h2>
        <p>Your data is encrypted at rest and in transit. We follow industry best practices for security.</p>
      </div>
    </div>
  </section>
  <CTASection />
</BaseLayout>
