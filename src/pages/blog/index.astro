---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogCard from '../../components/BlogCard.astro';
import Button from '../../components/Button.astro';
import Newsletter from '../../components/Newsletter.astro';

const allPosts = await getCollection('blog', ({ data }) => {
  // We now include future posts in the build, but still exclude drafts
  return import.meta.env.DEV || !data.draft;
});
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const featuredPost = sortedPosts.find(post => post.data.featured) || sortedPosts[0];
const latestPosts = sortedPosts.filter(post => post.id !== featuredPost.id);
const categories = ['All', ...new Set(allPosts.map(post => post.data.category))];
---

<BaseLayout 
  title="Compliance Blog & Resources" 
  description="Guides, updates, and practical insights for organizations managing compliance, policies, and audit readiness."
>
  <!-- Blog Hero -->
  <section class="py-20 bg-neutral-50 border-b border-neutral-200">
    <div class="container mx-auto px-6 text-center max-w-4xl">
      <h1 class="text-4xl md:text-5xl font-bold text-neutral-900 mb-6">
        Compliance Insights Backed by Proof
      </h1>
      <p class="text-xl text-neutral-600 mb-10 leading-relaxed">
        Guides, updates, and practical insights for organizations managing compliance, policies, and audit readiness.
      </p>
      <div class="flex justify-center">
        <Button href="#articles">Explore Articles</Button>
      </div>
    </div>
  </section>

  <!-- Featured Article -->
  <section class="py-16 bg-white" id="articles">
    <div class="container mx-auto px-6">
      <h2 class="text-xs font-bold uppercase tracking-widest text-neutral-600 mb-8">Featured Article</h2>
      {featuredPost && (
        <div class="scheduled-post" data-publish-date={featuredPost.data.pubDate.toISOString()}>
          <BlogCard 
            title={featuredPost.data.title}
            description={featuredPost.data.description}
            pubDate={featuredPost.data.pubDate}
            category={featuredPost.data.category}
            readingTime={featuredPost.data.readingTime}
            image={featuredPost.data.image}
            slug={featuredPost.id}
            isFeatured={true}
            loading="eager"
            fetchpriority="high"
          />
        </div>
      )}
    </div>
  </section>

  <!-- Latest Articles -->
  <section class="py-16 bg-neutral-50">
    <div class="container mx-auto px-6">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 mb-12">
        <h2 class="text-xs font-bold uppercase tracking-widest text-neutral-600">Latest Articles</h2>
        
        <div class="flex flex-wrap gap-2" id="category-filters">
          {categories.map(category => (
            <button 
              data-category={category}
              class:list={[
                "px-4 py-2 rounded-full text-sm font-medium transition-all border",
                category === 'All' 
                  ? "bg-proofyx-blue text-white border-proofyx-blue" 
                  : "bg-white text-neutral-600 border-neutral-200 hover:border-proofyx-blue hover:text-proofyx-blue"
              ]}
            >
              {category}
            </button>
          ))}
        </div>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8" id="blog-grid">
        {latestPosts.map(post => (
          <div 
            class="blog-post-card scheduled-post transition-all duration-500" 
            data-category={post.data.category}
            data-publish-date={post.data.pubDate.toISOString()}
          >
            <BlogCard 
              title={post.data.title}
              description={post.data.description}
              pubDate={post.data.pubDate}
              category={post.data.category}
              readingTime={post.data.readingTime}
              image={post.data.image}
              slug={post.id}
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <style>
    /* Hide scheduled posts by default in production */
    .scheduled-post {
      display: none;
    }
    /* Always show in dev mode */
    :global(.is-dev) .scheduled-post {
      display: block !important;
    }
  </style>

  <script>
    function setupScheduling() {
      const isDev = document.documentElement.classList.contains('is-dev');
      const now = new Date();
      const scheduledPosts = document.querySelectorAll('.scheduled-post');
      
      scheduledPosts.forEach(post => {
        const publishDate = new Date((post as HTMLElement).dataset.publishDate || '');
        if (isDev || publishDate <= now) {
          (post as HTMLElement).style.display = 'block';
        } else {
          (post as HTMLElement).style.display = 'none';
        }
      });
    }

    function setupFilters() {
      const filterButtons = document.querySelectorAll('#category-filters button');
      const posts = document.querySelectorAll('.blog-post-card');

      filterButtons.forEach(button => {
        button.addEventListener('click', () => {
          const category = button.getAttribute('data-category');
          const now = new Date();
          const isDev = document.documentElement.classList.contains('is-dev');

          // Update buttons
          filterButtons.forEach(btn => {
            btn.classList.remove('bg-proofyx-blue', 'text-white', 'border-proofyx-blue');
            btn.classList.add('bg-white', 'text-neutral-600', 'border-neutral-200');
          });
          button.classList.add('bg-proofyx-blue', 'text-white', 'border-proofyx-blue');
          button.classList.remove('bg-white', 'text-neutral-600', 'border-neutral-200');

          // Filter posts
          posts.forEach(post => {
            const postCategory = post.getAttribute('data-category');
            const publishDate = new Date((post as HTMLElement).dataset.publishDate || '');
            const isPublished = isDev || publishDate <= now;

            if (isPublished && (category === 'All' || postCategory === category)) {
              (post as HTMLElement).style.display = 'block';
              setTimeout(() => {
                (post as HTMLElement).style.opacity = '1';
                (post as HTMLElement).style.transform = 'translateY(0)';
              }, 10);
            } else {
              (post as HTMLElement).style.opacity = '0';
              (post as HTMLElement).style.transform = 'translateY(20px)';
              setTimeout(() => {
                (post as HTMLElement).style.display = 'none';
              }, 500);
            }
          });
        });
      });
    }

    setupScheduling();
    setupFilters();
    document.addEventListener('astro:after-swap', () => {
      setupScheduling();
      setupFilters();
    });
  </script>

  <!-- 
  <div class="container mx-auto px-6 mb-24">
    <Newsletter />
  </div>
  -->

  <section class="py-24 bg-white">
    <div class="container mx-auto px-6 text-center">
      <div class="max-w-3xl mx-auto">
        <h3 class="text-3xl font-bold text-neutral-900 mb-6">Ready to build your own audit-ready proof?</h3>
        <p class="text-xl text-neutral-600 mb-10">Our team of compliance experts is here to help you navigate your regulatory requirements.</p>
        <Button href="/contact" size="lg">Get in Touch</Button>
      </div>
    </div>
  </section>
</BaseLayout>
