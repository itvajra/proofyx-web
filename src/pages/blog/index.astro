---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogCard from '../../components/BlogCard.astro';
import Button from '../../components/Button.astro';
import Newsletter from '../../components/Newsletter.astro';
import CTASection from '../../components/CTASection.astro';

const allPosts = await getCollection('blog', ({ data }) => {
  return import.meta.env.DEV || !data.draft;
});
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const featuredPost = sortedPosts.find(post => post.data.featured) || sortedPosts[0];
const latestPosts = sortedPosts.filter(post => post.id !== featuredPost.id);
const categories = ['All', ...new Set(allPosts.map(post => post.data.category))];

const featuredDate = new Intl.DateTimeFormat('en-US', {
  month: 'short', day: 'numeric', year: 'numeric',
}).format(featuredPost?.data.pubDate);
---

<BaseLayout 
  title="Compliance Blog & Intelligence" 
  description="Expert guides, regulatory updates, and practical workflows for organizations building audit-ready compliance postures."
  headerTransparent={false}
  backgroundClass="bg-[#f8f9fb]"
>

  <!-- HERO -->
  <section class="relative bg-[#0c1220] overflow-hidden">
    <div class="absolute -top-40 -left-40 w-[700px] h-[700px] bg-blue-600/10 rounded-full blur-[120px] pointer-events-none"></div>
    <div class="absolute top-0 right-0 w-[400px] h-[500px] bg-indigo-600/8 rounded-full blur-[100px] pointer-events-none"></div>
    <div class="absolute inset-0 opacity-[0.05]" style="background-image: radial-gradient(rgba(255,255,255,0.5) 1px, transparent 1px); background-size: 28px 28px;" aria-hidden="true"></div>

    <div class="container mx-auto px-6 pt-16 pb-24 md:pt-20 md:pb-32 relative z-10 text-center">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-blue-500/15 border border-blue-500/25 text-blue-300 text-xs font-semibold tracking-widest uppercase mb-8">
        <span class="w-1.5 h-1.5 rounded-full bg-blue-400 animate-pulse"></span>
        Compliance Intelligence
      </div>
      <h1 class="text-5xl md:text-6xl lg:text-7xl font-extrabold text-white tracking-tight leading-[1.05] mb-7 max-w-4xl mx-auto">
        The Compliance<br class="hidden md:block" /> Intelligence Library
      </h1>
      <p class="text-lg md:text-xl text-slate-400 leading-relaxed max-w-2xl mx-auto mb-12 font-normal">
        Expert analysis, regulatory updates, and practical guides for security and compliance teams.
      </p>
      <a href="#articles" class="inline-flex items-center gap-2 px-8 py-4 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-semibold transition-all shadow-xl shadow-blue-600/25 hover:shadow-blue-500/30 hover:-translate-y-0.5">
        Browse articles
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </div>
  </section>

  <!-- CONTENT -->
  <div class="bg-[#f8f9fb]">

    <!-- ══════════════════════════════════
         FEATURED — Full-width editorial
    ══════════════════════════════════ -->
    <section class="pt-14 pb-10" id="articles">
      <div class="container mx-auto px-6">
        <div class="max-w-5xl mx-auto">
          <div class="flex items-center gap-3 mb-8">
            <span class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-widest text-blue-600">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              Featured
            </span>
            <div class="h-px flex-1 bg-slate-200"></div>
          </div>

          {featuredPost && (
            <div class="scheduled-post" data-publish-date={featuredPost.data.pubDate.toISOString()}>
              <!-- Large featured editorial card -->
              <a href={`/blog/${featuredPost.id}`} class="group block bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-[0_4px_24px_rgba(0,0,0,0.08)] hover:shadow-[0_16px_48px_rgba(0,0,0,0.13)] hover:-translate-y-1 transition-all duration-300 md:grid md:grid-cols-[1.2fr_1fr]">
                <!-- Image -->
                <div class="relative overflow-hidden bg-slate-100 aspect-[4/3] md:aspect-auto">
                  {featuredPost.data.image ? (
                    <Image
                      src={featuredPost.data.image}
                      alt={featuredPost.data.title}
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out"
                      loading="eager"
                      fetchpriority="high"
                    />
                  ) : (
                    <div class="w-full h-full bg-gradient-to-br from-slate-800 to-[#0c1220] flex items-center justify-center min-h-[280px]">
                      <svg width="64" height="64" fill="none" stroke="rgba(255,255,255,0.1)" stroke-width="1" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.333 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z"/></svg>
                    </div>
                  )}
                  <!-- Dark overlay at bottom for visual interest -->
                  <div class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent"></div>
                </div>

                <!-- Content -->
                <div class="p-8 md:p-12 flex flex-col justify-center">
                  <div class="flex items-center gap-2 mb-5">
                    <span class="px-2.5 py-1 rounded-md bg-blue-50 text-blue-700 text-xs font-bold border border-blue-100 uppercase tracking-wide">{featuredPost.data.category}</span>
                    <span class="text-slate-300">·</span>
                    <time class="text-slate-400 text-sm">{featuredDate}</time>
                    <span class="text-slate-300">·</span>
                    <span class="text-slate-400 text-sm">{featuredPost.data.readingTime}</span>
                  </div>
                  <h2 class="text-2xl md:text-3xl lg:text-4xl font-extrabold text-slate-900 leading-tight tracking-tight mb-4 group-hover:text-blue-700 transition-colors">
                    {featuredPost.data.title}
                  </h2>
                  <p class="text-slate-500 leading-relaxed mb-8 line-clamp-3 text-base md:text-lg">{featuredPost.data.description}</p>
                  <div class="inline-flex items-center gap-2 text-blue-600 font-semibold text-sm mt-auto">
                    Read article
                    <svg class="group-hover:translate-x-1 transition-transform" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                  </div>
                </div>
              </a>
            </div>
          )}
        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════
         ALL POSTS GRID
    ══════════════════════════════════ -->
    <section class="py-10 pb-16">
      <div class="container mx-auto px-6">
        <div class="max-w-5xl mx-auto">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
            <div>
              <h2 class="text-xl font-bold text-slate-900">All articles</h2>
              <p class="text-slate-400 text-sm mt-0.5">{latestPosts.length + 1} posts</p>
            </div>
            <!-- Category filters -->
            <div class="flex flex-wrap gap-1.5 p-1 bg-white rounded-xl border border-slate-200 shadow-sm" id="category-filters">
              {categories.map(category => (
                <button
                  data-category={category}
                  class:list={[
                    "px-4 py-1.5 rounded-lg text-xs font-semibold transition-all duration-200",
                    category === 'All'
                      ? "bg-slate-900 text-white shadow-sm"
                      : "text-slate-500 hover:text-slate-800 hover:bg-slate-50"
                  ]}
                >
                  {category}
                </button>
              ))}
            </div>
          </div>

          <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6" id="blog-grid">
            {latestPosts.map(post => (
              <div
                class="blog-post-card"
                data-category={post.data.category}
                data-publish-date={post.data.pubDate.toISOString()}
              >
                <BlogCard
                  title={post.data.title}
                  description={post.data.description}
                  pubDate={post.data.pubDate}
                  category={post.data.category}
                  readingTime={post.data.readingTime}
                  image={post.data.image}
                  slug={post.id}
                />
              </div>
            ))}
          </div>

          <!-- Empty state -->
          <div id="no-results" class="hidden text-center py-16">
            <p class="text-slate-400 text-base">No articles in this category yet.</p>
          </div>
        </div>
      </div>
    </section>

  </div>

  <!-- Newsletter -->
  <Newsletter
    heading="Compliance intelligence, straight to your inbox."
    subtext="Practical guides for CMMC, NIST, and SOC2 — delivered bi-weekly by the Proofyx team."
  />

  <!-- CTA Banner -->

  <CTASection />

  <style>
    /* Base: all blog-post-cards start hidden (via JS, not CSS, to avoid !important fights) */
    /* We use a class toggle approach instead of style.display to avoid the is-dev !important conflict */
    .blog-post-card.js-hidden { display: none !important; }
    /* Featured post scheduling still uses the old approach */
    .scheduled-post { display: none; }
  </style>

  <script>
    function setupScheduling() {
      const isDev = document.documentElement.classList.contains('is-dev');
      const now = new Date();

      // Featured post
      document.querySelectorAll('.scheduled-post').forEach(el => {
        const d = new Date((el as HTMLElement).dataset.publishDate || '');
        (el as HTMLElement).style.display = (isDev || d <= now) ? 'block' : 'none';
      });

      // Regular posts: show/hide without !important conflicts
      document.querySelectorAll('.blog-post-card').forEach(el => {
        const d = new Date((el as HTMLElement).dataset.publishDate || '');
        const shouldShow = isDev || d <= now;
        if (shouldShow) {
          el.classList.remove('js-hidden');
        } else {
          el.classList.add('js-hidden');
        }
      });
    }

    function setupFilters() {
      const btns = document.querySelectorAll('#category-filters button');
      const posts = document.querySelectorAll<HTMLElement>('.blog-post-card');
      const noResults = document.getElementById('no-results');

      btns.forEach(btn => {
        btn.addEventListener('click', () => {
          const cat = btn.getAttribute('data-category');
          const isDev = document.documentElement.classList.contains('is-dev');
          const now = new Date();

          // Update active button style
          btns.forEach(b => {
            b.classList.remove('bg-slate-900', 'text-white', 'shadow-sm');
            b.classList.add('text-slate-500');
          });
          btn.classList.add('bg-slate-900', 'text-white', 'shadow-sm');
          btn.classList.remove('text-slate-500');

          // Filter posts
          let visibleCount = 0;
          posts.forEach(post => {
            const postCat = post.getAttribute('data-category');
            const d = new Date(post.dataset.publishDate || '');
            const isPublished = isDev || d <= now;
            const matchesCat = cat === 'All' || postCat === cat;

            if (isPublished && matchesCat) {
              post.classList.remove('js-hidden');
              visibleCount++;
            } else {
              post.classList.add('js-hidden');
            }
          });

          // Show empty state
          if (noResults) {
            noResults.classList.toggle('hidden', visibleCount > 0);
          }
        });
      });
    }

    setupScheduling();
    setupFilters();
    document.addEventListener('astro:after-swap', () => {
      setupScheduling();
      setupFilters();
    });
  </script>
</BaseLayout>
