---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogCard from '../../components/BlogCard.astro';
import Button from '../../components/Button.astro';

const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const featuredPost = sortedPosts.find(post => post.data.featured) || sortedPosts[0];
const latestPosts = sortedPosts.filter(post => post.id !== featuredPost.id);
---

<BaseLayout 
  title="Compliance Blog & Resources" 
  description="Guides, updates, and practical insights for organizations managing compliance, policies, and audit readiness."
>
  <!-- Blog Hero -->
  <section class="py-20 bg-neutral-50 border-b border-neutral-200">
    <div class="container mx-auto px-6 text-center max-w-4xl">
      <h1 class="text-4xl md:text-5xl font-bold text-neutral-900 mb-6">
        Compliance Insights Backed by Proof
      </h1>
      <p class="text-xl text-neutral-600 mb-10 leading-relaxed">
        Guides, updates, and practical insights for organizations managing compliance, policies, and audit readiness.
      </p>
      <div class="flex justify-center">
        <Button href="#articles">Explore Articles</Button>
      </div>
    </div>
  </section>

  <!-- Featured Article -->
  <section class="py-16 bg-white" id="articles">
    <div class="container mx-auto px-6">
      <h2 class="text-xs font-bold uppercase tracking-widest text-neutral-400 mb-8">Featured Article</h2>
      {featuredPost && (
        <BlogCard 
          title={featuredPost.data.title}
          description={featuredPost.data.description}
          pubDate={featuredPost.data.pubDate}
          category={featuredPost.data.category}
          readingTime={featuredPost.data.readingTime}
          image={featuredPost.data.image}
          slug={featuredPost.id}
          isFeatured={true}
        />
      )}
    </div>
  </section>

  <!-- Latest Articles -->
  <section class="py-16 bg-neutral-50">
    <div class="container mx-auto px-6">
      <h2 class="text-xs font-bold uppercase tracking-widest text-neutral-400 mb-8">Latest Articles</h2>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {latestPosts.map(post => (
          <BlogCard 
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            category={post.data.category}
            readingTime={post.data.readingTime}
            image={post.data.image}
            slug={post.id}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="py-24 bg-white">
    <div class="container mx-auto px-6 text-center">
      <div class="max-w-3xl mx-auto">
        <h3 class="text-3xl font-bold text-neutral-900 mb-6">Ready to build your own audit-ready proof?</h3>
        <p class="text-xl text-neutral-600 mb-10">Our team of compliance experts is here to help you navigate your regulatory requirements.</p>
        <Button href="/contact" size="lg">Get in Touch</Button>
      </div>
    </div>
  </section>
</BaseLayout>
