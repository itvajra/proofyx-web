---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import CTASection from '../components/CTASection.astro';

const lifecycleSteps = [
  { title: "Author", desc: "Collaborate on policy drafts with built-in versioning." },
  { title: "Approve", desc: "Digital approval workflows for stakeholders." },
  { title: "Publish", desc: "Centralized portal for employee access." },
  { title: "Acknowledge", desc: "Track employee signatures and understanding." }
];
---

<BaseLayout title="Policy Module" description="Modern policy lifecycle management for enterprise organizations.">
  <!-- Hero Section -->
  <section class="relative pt-32 pb-24 bg-white overflow-hidden">
    <div class="container mx-auto px-6 text-center max-w-4xl">
      <span class="inline-block px-4 py-1.5 bg-proofyx-green/10 text-proofyx-green text-xs font-bold uppercase tracking-widest rounded-full mb-6">
        Governance & Risk
      </span>
      <h1 class="text-4xl md:text-6xl font-bold text-neutral-900 mb-8 leading-tight">
        Professional Policy <span class="text-proofyx-green">Lifecycle Management</span>
      </h1>
      <p class="text-xl text-neutral-600 leading-relaxed mb-10">
        Policies are the foundation of compliance. Proofyx ensures your policies are current, approved, and acknowledged across your entire organization with full accountability.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <Button href="https://policy.proofyx.com" class="!bg-proofyx-green hover:!bg-green-700" size="lg">Launch Policy App</Button>
        <Button href="/contact" variant="outline" size="lg">Request a Demo</Button>
      </div>
    </div>
  </section>

  <!-- Lifecycle Section -->
  <section class="py-24 bg-neutral-50 border-y border-neutral-100">
    <div class="container mx-auto px-6">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-neutral-900 mb-4">The Complete Policy Lifecycle</h2>
        <p class="text-neutral-600 max-w-2xl mx-auto">Manage every stage of your governance documents with automated workflows and full audit trails.</p>
      </div>

      <div class="grid md:grid-cols-4 gap-8">
        {lifecycleSteps.map((step, index) => (
          <div class="relative group">
            <div class="p-8 bg-white border border-neutral-200 rounded-xl hover:shadow-enterprise transition-all relative z-10">
              <div class="w-10 h-10 bg-proofyx-green text-white rounded-full flex items-center justify-center font-bold mb-6">
                0{index + 1}
              </div>
              <h3 class="font-bold text-xl text-neutral-900 mb-3">{step.title}</h3>
              <p class="text-neutral-600 text-sm leading-relaxed">{step.desc}</p>
            </div>
            {index < 3 && (
              <div class="hidden lg:block absolute top-1/2 -right-4 w-8 h-0.5 bg-neutral-200 z-0"></div>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Details Section -->
  <section class="py-24 bg-white">
    <div class="container mx-auto px-6">
      <div class="grid md:grid-cols-2 gap-16 items-center">
        <div class="order-2 md:order-1">
          <div class="bg-neutral-50 border border-neutral-200 rounded-2xl p-12 aspect-video flex items-center justify-center relative overflow-hidden shadow-inner group">
             <!-- Document Illustration -->
             <div class="relative w-64 h-80 bg-white rounded-lg shadow-xl border border-neutral-200 transform -rotate-6 group-hover:rotate-0 transition-transform duration-700 p-8">
                <div class="h-2 w-1/2 bg-proofyx-green/20 rounded mb-4"></div>
                <div class="h-4 w-3/4 bg-neutral-900/10 rounded mb-8"></div>
                <div class="space-y-3">
                  <div class="h-2 w-full bg-neutral-100 rounded"></div>
                  <div class="h-2 w-full bg-neutral-100 rounded"></div>
                  <div class="h-2 w-5/6 bg-neutral-100 rounded"></div>
                  <div class="h-2 w-full bg-neutral-100 rounded"></div>
                  <div class="h-2 w-4/6 bg-neutral-100 rounded"></div>
                </div>
                <div class="absolute bottom-8 right-8 w-16 h-8 bg-proofyx-green/10 rounded-md flex items-center justify-center">
                  <div class="w-8 h-1 bg-proofyx-green/40 rounded"></div>
                </div>
             </div>
             <div class="absolute inset-0 bg-gradient-to-tr from-proofyx-green/5 to-transparent pointer-events-none"></div>
          </div>
        </div>
        
        <div class="order-1 md:order-2">
          <h2 class="text-3xl md:text-4xl font-bold mb-8">Centralize Your Governance</h2>
          <p class="text-lg text-neutral-600 mb-10">
            Manage the entire policy lifecycle—from initial drafting and collaboration to final approval and employee acknowledgement. Proofyx keeps a permanent record of every version for future audits.
          </p>
          
          <div class="space-y-6">
            <div class="flex gap-4">
              <div class="w-6 h-6 bg-proofyx-green/10 text-proofyx-green rounded flex items-center justify-center shrink-0 mt-1">✓</div>
              <div>
                <h3 class="font-bold text-neutral-900">Approval Workflows</h3>
                <p class="text-neutral-600 text-sm">Route policies through custom approval chains. Track who approved, when, and any comments for a permanent record.</p>
              </div>
            </div>
            <div class="flex gap-4">
              <div class="w-6 h-6 bg-proofyx-green/10 text-proofyx-green rounded flex items-center justify-center shrink-0 mt-1">✓</div>
              <div>
                <h3 class="font-bold text-neutral-900">Version Control</h3>
                <p class="text-neutral-600 text-sm">Every edit creates a new version. Compare versions side-by-side and see exactly what changed over time.</p>
              </div>
            </div>
            <div class="flex gap-4">
              <div class="w-6 h-6 bg-proofyx-green/10 text-proofyx-green rounded flex items-center justify-center shrink-0 mt-1">✓</div>
              <div>
                <h3 class="font-bold text-neutral-900">Acknowledgement Tracking</h3>
                <p class="text-neutral-600 text-sm">Require users to acknowledge policies. Track signatures with timestamps and automated reminder campaigns.</p>
              </div>
            </div>
            <div class="flex gap-4">
              <div class="w-6 h-6 bg-proofyx-green/10 text-proofyx-green rounded flex items-center justify-center shrink-0 mt-1">✓</div>
              <div>
                <h3 class="font-bold text-neutral-900">Compliance Mapping</h3>
                <p class="text-neutral-600 text-sm">Link policies to specific compliance requirements to show how your governance satisfies regulatory obligations.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Versioning & Audit History -->
  <section class="py-24 bg-neutral-900 text-white relative overflow-hidden">
    <!-- Decor -->
    <div class="absolute top-0 left-0 w-1/2 h-full bg-gradient-to-r from-proofyx-green/10 to-transparent pointer-events-none"></div>
    
    <div class="container mx-auto px-6 relative z-10">
      <div class="text-center mb-20">
        <span class="inline-block px-4 py-1.5 bg-white/10 text-proofyx-green font-bold uppercase tracking-widest text-xs rounded-full mb-6">Accountability</span>
        <h2 class="text-3xl md:text-5xl font-bold mb-4 text-white">Versioning and Audit History</h2>
        <p class="text-white/60 max-w-2xl mx-auto text-lg">
          Every change to a policy is tracked. Auditors can see the complete history of policy evolution and approvals.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-x-12 gap-y-16">
        <div class="flex gap-6 group">
          <div class="w-14 h-14 bg-proofyx-green/10 text-proofyx-green rounded-2xl flex items-center justify-center shrink-0 text-2xl border border-proofyx-green/20 group-hover:bg-proofyx-green/20 group-hover:border-proofyx-green/40 transition-all duration-300 shadow-[0_0_15px_rgba(34,197,94,0.15)]">📝</div>
          <div>
            <h3 class="text-xl font-bold mb-3 text-white">Complete Version History</h3>
            <p class="text-white/60 text-sm leading-relaxed">Every edit creates a new version. View any previous version, see what changed, and who made the change.</p>
          </div>
        </div>
        <div class="flex gap-6 group">
          <div class="w-14 h-14 bg-proofyx-green/10 text-proofyx-green rounded-2xl flex items-center justify-center shrink-0 text-2xl border border-proofyx-green/20 group-hover:bg-proofyx-green/20 group-hover:border-proofyx-green/40 transition-all duration-300 shadow-[0_0_15px_rgba(34,197,94,0.15)]">🔍</div>
          <div>
            <h3 class="text-xl font-bold mb-3 text-white">Version Comparison</h3>
            <p class="text-white/60 text-sm leading-relaxed">Compare any two versions side-by-side. See exactly what text was added, removed, or modified.</p>
          </div>
        </div>
        <div class="flex gap-6 group">
          <div class="w-14 h-14 bg-proofyx-green/10 text-proofyx-green rounded-2xl flex items-center justify-center shrink-0 text-2xl border border-proofyx-green/20 group-hover:bg-proofyx-green/20 group-hover:border-proofyx-green/40 transition-all duration-300 shadow-[0_0_15px_rgba(34,197,94,0.15)]">⏱️</div>
          <div>
            <h3 class="text-xl font-bold mb-3 text-white">Timestamped Changes</h3>
            <p class="text-white/60 text-sm leading-relaxed">Every version includes timestamp, author, and reason for change. No retroactive edits possible.</p>
          </div>
        </div>
        <div class="flex gap-6 group">
          <div class="w-14 h-14 bg-proofyx-green/10 text-proofyx-green rounded-2xl flex items-center justify-center shrink-0 text-2xl border border-proofyx-green/20 group-hover:bg-proofyx-green/20 group-hover:border-proofyx-green/40 transition-all duration-300 shadow-[0_0_15px_rgba(34,197,94,0.15)]">✅</div>
          <div>
            <h3 class="text-xl font-bold mb-3 text-white">Approval Records</h3>
            <p class="text-white/60 text-sm leading-relaxed">Approvals are permanently linked to specific policy versions. See who approved what, and when.</p>
          </div>
        </div>
        <div class="flex gap-6 group">
          <div class="w-14 h-14 bg-proofyx-green/10 text-proofyx-green rounded-2xl flex items-center justify-center shrink-0 text-2xl border border-proofyx-green/20 group-hover:bg-proofyx-green/20 group-hover:border-proofyx-green/40 transition-all duration-300 shadow-[0_0_15px_rgba(34,197,94,0.15)]">👥</div>
          <div>
            <h3 class="text-xl font-bold mb-3 text-white">Acknowledgment Tracking</h3>
            <p class="text-white/60 text-sm leading-relaxed">Track which users have acknowledged each policy version. Evidence of policy distribution and acceptance.</p>
          </div>
        </div>
        <div class="flex gap-6 group">
          <div class="w-14 h-14 bg-proofyx-green/10 text-proofyx-green rounded-2xl flex items-center justify-center shrink-0 text-2xl border border-proofyx-green/20 group-hover:bg-proofyx-green/20 group-hover:border-proofyx-green/40 transition-all duration-300 shadow-[0_0_15px_rgba(34,197,94,0.15)]">🔒</div>
          <div>
            <h3 class="text-xl font-bold mb-3 text-white">Immutable Audit Log</h3>
            <p class="text-white/60 text-sm leading-relaxed">All policy actions are logged in an immutable audit trail. Complete chain of custody for compliance.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Compliance Integration -->
  <section class="py-24 bg-white">
    <div class="container mx-auto px-6">
      <div class="grid md:grid-cols-2 gap-16 items-center">
        <div>
          <h2 class="text-3xl md:text-4xl font-bold text-neutral-900 mb-8">Mapped to Compliance Needs</h2>
          <p class="text-lg text-neutral-600 mb-10">
            Policies don't exist in isolation. Link them to compliance requirements to show how your governance satisfies regulatory obligations.
          </p>
          
          <div class="grid gap-8">
            <div class="p-6 rounded-xl bg-neutral-50 border border-neutral-100">
              <h3 class="font-bold text-neutral-900 mb-2">Link to Requirements</h3>
              <p class="text-neutral-600 text-sm">Map policies to specific compliance requirements (e.g., CMMC or NIST). Show which policies satisfy which controls.</p>
            </div>
            <div class="p-6 rounded-xl bg-neutral-50 border border-neutral-100">
              <h3 class="font-bold text-neutral-900 mb-2">Coverage Reports</h3>
              <p class="text-neutral-600 text-sm">See which requirements are covered by policies and which need attention. Identify gaps in policy coverage.</p>
            </div>
            <div class="p-6 rounded-xl bg-neutral-50 border border-neutral-100">
              <h3 class="font-bold text-neutral-900 mb-2">Evidence for Audits</h3>
              <p class="text-neutral-600 text-sm">Policies become evidence for compliance controls. Export policy documents with approval records for assessors.</p>
            </div>
          </div>
        </div>
        
        <div class="bg-neutral-900 rounded-2xl p-10 lg:p-14 text-white overflow-hidden relative group shadow-2xl border border-neutral-800 hover:border-proofyx-green/50 transition-colors duration-500">
          <div class="absolute -top-6 left-6 text-[12rem] font-serif leading-none text-white/[0.03] pointer-events-none group-hover:-translate-y-4 group-hover:text-white/[0.05] transition-all duration-700">"</div>
          <div class="relative z-10">
            <div class="inline-flex items-center gap-2 px-3 py-1.5 bg-proofyx-green/10 border border-proofyx-green/20 rounded-full text-proofyx-green font-bold text-xs uppercase tracking-widest mb-8">
               <span class="w-2 h-2 rounded-full bg-proofyx-green animate-pulse"></span>
               Audit Ready
            </div>
            <h3 class="text-3xl lg:text-4xl font-serif mb-8 italic leading-snug text-white/90 group-hover:text-white transition-colors duration-300">
              Show me the policy, show me the approval, and show me that people read it.
            </h3>
            <div class="w-12 h-1 bg-proofyx-green mb-8 opacity-80 group-hover:w-16 transition-all duration-500"></div>
            <p class="text-white/60 text-lg leading-relaxed">The three questions every auditor asks. <span class="text-white font-medium">Proofyx answers all of them in one click.</span></p>
          </div>
          <div class="absolute -bottom-24 -right-24 w-80 h-80 bg-proofyx-green/20 rounded-full blur-3xl group-hover:bg-proofyx-green/30 transition-colors duration-700"></div>
        </div>
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>
