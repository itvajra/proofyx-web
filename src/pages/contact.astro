---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
---
<BaseLayout title="Contact Us" description="Have questions about Proofyx? Our team is here to help you build audit-ready proof.">
  <section class="py-24 bg-white">
    <div class="container mx-auto px-6 max-w-4xl">
      <div class="text-center mb-16">
        <h1 class="text-4xl md:text-5xl font-bold mb-6 text-neutral-900">Get in Touch</h1>
        <p class="text-xl text-neutral-600 max-w-2xl mx-auto">
          Have questions about our compliance platform or policy management tools? Our experts are ready to help.
        </p>
      </div>
      
      <div class="max-w-2xl mx-auto">
        <ContactForm />
      </div>

      <div class="mt-24 pt-24 border-t border-neutral-100">
        <div class="text-center max-w-xs mx-auto">
          <div class="w-12 h-12 bg-proofyx-blue-light text-proofyx-blue rounded-full flex items-center justify-center mx-auto mb-6">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
          </div>
          <h4 class="font-bold mb-2 text-neutral-900">Email Us</h4>
          <a href="mailto:support@proofyx.com" class="text-proofyx-blue hover:text-proofyx-blue-dark transition-colors font-medium">
            support@proofyx.com
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
