---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import CTASection from '../components/CTASection.astro';
import ContactForm from '../components/ContactForm.astro';
import DashboardMockup from '../components/DashboardMockup.astro';
import Newsletter from '../components/Newsletter.astro';

const features = [
  {
    title: "Audit-Ready Evidence",
    description: "Centralize your proof with automated collection and mapping to major frameworks.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-10 h-10"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.333 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" /></svg>`
  },
  {
    title: "Policy Lifecycle",
    description: "Manage policies from creation to retirement with full version control and audit logs.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-10 h-10"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 0 0 2.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 0 0-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .415.162.798.425 1.081.263.283.62.463 1.015.463h.123c.395 0 .752-.18 1.015-.463a1.64 1.64 0 0 0 .425-1.081c0-.231-.035-.454-.1-.664m-5.801 0A2.251 2.251 0 0 1 13.5 2.255c.628 0 1.228.245 1.679.689l1.583 1.583c.15.15.342.225.534.225h.123c.192 0 .384-.075.534-.225l1.583-1.583c.451-.444 1.051-.689 1.679-.689a2.251 2.251 0 0 1 2.25 2.25V18.75a2.25 2.25 0 0 1-2.25 2.25h-5.25a2.25 2.25 0 0 1-2.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 0 0-1.123-.08M9 6h6.75" /></svg>`
  },
  {
    title: "Framework Mapping",
    description: "Map evidence once and apply it across CMMC, NIST, SOC2, and more.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-10 h-10"><path stroke-linecap="round" stroke-linejoin="round" d="M9 6.75V15m6-10.5v8.25m.75 4.5a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm-6 0a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm11.25-11.25a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm-10.5 0a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z" /></svg>`
  }
];
---

<BaseLayout title="Home">
  <!-- Hero Section -->
  <section class="relative bg-proofyx-navy pt-32 pb-48 overflow-hidden">
    <div class="container mx-auto px-6 relative z-10 grid md:grid-cols-2 gap-12 items-center">
      <div>
        <h1 class="text-5xl md:text-6xl font-bold text-white mb-8 leading-tight">
          Compliance Proof <br /><span class="text-proofyx-blue-light">Built for Audits.</span>
        </h1>
        <p class="text-xl text-white/80 mb-10 leading-relaxed max-w-xl">
          Move beyond spreadsheets. Proofyx centralizes your evidence, policies, and compliance workflows for organizations that can't afford to fail an audit.
        </p>
        <div class="flex flex-wrap gap-4">
          <button onclick="document.getElementById('get-started').scrollIntoView({behavior: 'smooth'})" class="bg-proofyx-blue text-white px-8 py-4 rounded-md text-lg font-semibold hover:bg-proofyx-blue-dark transition-all">Get Started</button>
          <Button href="/compliance" variant="outline" size="lg" class="!border-white/20 !text-white hover:!bg-white/10">Explore Compliance</Button>
        </div>
      </div>
      <div class="hidden md:block">
        <DashboardMockup />
      </div>
    </div>
    
    <!-- Background Decor -->
    <div class="absolute -top-24 -right-24 w-96 h-96 bg-proofyx-blue/20 rounded-full blur-3xl"></div>
    <div class="absolute -bottom-24 -left-24 w-96 h-96 bg-proofyx-green/10 rounded-full blur-3xl"></div>
  </section>

  <!-- Feature Grid -->
  <section class="py-24 bg-white">
    <div class="container mx-auto px-6">
      <div class="text-center mb-20">
        <h2 class="text-3xl md:text-4xl font-bold text-neutral-900 mb-4">Enterprise Compliance Management</h2>
        <p class="text-neutral-600 max-w-2xl mx-auto text-lg">
          Everything you need to manage your compliance posture and policy lifecycle in one unified platform.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-12">
        {features.map(feature => (
          <div class="group p-8 rounded-xl border border-neutral-100 bg-neutral-50 hover:bg-white hover:shadow-enterprise-hover hover:border-proofyx-blue/20 transition-all duration-300">
            <div class="text-proofyx-blue mb-6" role="img" aria-label={feature.title} set:html={feature.icon}></div>
            <h3 class="text-xl font-bold mb-4 group-hover:text-proofyx-blue transition-colors">{feature.title}</h3>
            <p class="text-neutral-600 leading-relaxed">{feature.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Choose Your Starting Point Section -->
  <section id="get-started" class="py-24 bg-neutral-50 scroll-mt-20">
    <div class="container mx-auto px-6">
      <div class="text-center mb-20">
        <h2 class="text-3xl md:text-4xl font-bold text-neutral-900 mb-4">Choose Your Starting Point</h2>
        <p class="text-neutral-600 max-w-2xl mx-auto text-lg">
          Select the product that best fits your needs. Each application is designed to help you build audit-ready proof.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-12">
        <!-- Compliance Card -->
        <div class="bg-white border border-neutral-200 rounded-2xl p-10 hover:shadow-enterprise-hover transition-all group relative overflow-hidden flex flex-col">
          <div class="absolute top-0 left-0 w-full h-1 bg-proofyx-blue"></div>
          <div class="flex items-center gap-3 mb-6">
            <div class="w-10 h-10 bg-proofyx-blue-light text-proofyx-blue rounded flex items-center justify-center font-bold" role="img" aria-label="Checkmark">✓</div>
            <span class="text-xs font-bold text-proofyx-blue uppercase tracking-widest">FOUNDATION · Controls & Evidence</span>
          </div>
          <h3 class="text-3xl font-bold mb-6">Compliance Management</h3>
          <p class="text-neutral-600 mb-8 text-lg">
            Guide and track compliance requirements into audit-ready proof.
          </p>
          <ul class="space-y-3 mb-10 flex-grow">
            <li class="flex items-start gap-3 text-neutral-700">
              <span class="text-proofyx-blue font-bold">•</span>
              <span><b>Guided</b> onboarding and framework-specific assessments</span>
            </li>
            <li class="flex items-start gap-3 text-neutral-700">
              <span class="text-proofyx-blue font-bold">•</span>
              <span><b>Audit-ready</b> evidence repository and control mapping</span>
            </li>
          </ul>
          <div class="flex gap-4">
            <Button href="https://compliance.proofyx.com" class="flex-grow">Get Started</Button>
            <Button href="/compliance" variant="outline" class="flex-grow">Learn more about Compliance</Button>
          </div>
        </div>

        <!-- Policy Card -->
        <div class="bg-white border border-neutral-200 rounded-2xl p-10 hover:shadow-enterprise-hover transition-all group relative overflow-hidden flex flex-col">
          <div class="absolute top-0 left-0 w-full h-1 bg-proofyx-green"></div>
          <div class="flex items-center gap-3 mb-6">
            <div class="w-10 h-10 bg-proofyx-green/10 text-proofyx-green rounded flex items-center justify-center" role="img" aria-label="Policy icon">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 0 0 2.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 0 0-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .415.162.798.425 1.081.263.283.62.463 1.015.463h.123c.395 0 .752-.18 1.015-.463a1.64 1.64 0 0 0 .425-1.081c0-.231-.035-.454-.1-.664m-5.801 0A2.251 2.251 0 0 1 13.5 2.255c.628 0 1.228.245 1.679.689l1.583 1.583c.15.15.342.225.534.225h.123c.192 0 .384-.075.534-.225l1.583-1.583c.451-.444 1.051-.689 1.679-.689a2.251 2.251 0 0 1 2.25 2.25V18.75a2.25 2.25 0 0 1-2.25 2.25h-5.25a2.25 2.25 0 0 1-2.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 0 0-1.123-.08M9 6h6.75" />
              </svg>
            </div>
            <span class="text-xs font-bold text-proofyx-green uppercase tracking-widest">GOVERNANCE · Policies & Accountability</span>
          </div>
          <h3 class="text-3xl font-bold mb-6">Policy Management</h3>
          <p class="text-neutral-600 mb-8 text-lg">
            Define intent. Enforce accountability. Prove alignment.
          </p>
          <ul class="space-y-3 mb-10 flex-grow">
            <li class="flex items-start gap-3 text-neutral-700">
              <span class="text-proofyx-green font-bold">•</span>
              <span><b>Policy lifecycle</b> management (Author, Approve, Publish)</span>
            </li>
            <li class="flex items-start gap-3 text-neutral-700">
              <span class="text-proofyx-green font-bold">•</span>
              <span><b>Bulk acknowledgement</b> and signature tracking</span>
            </li>
          </ul>
          <div class="flex gap-4">
            <Button href="https://policy.proofyx.com" class="flex-grow !bg-proofyx-green hover:!bg-green-700">Get Started</Button>
            <Button href="/policy" variant="outline" class="flex-grow !border-proofyx-green !text-proofyx-green hover:!bg-proofyx-green/5">Learn more about Policy</Button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Built For Compliance Teams -->
  <section class="py-24 bg-white border-b border-neutral-100">
    <div class="container mx-auto px-6">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-neutral-900 mb-4">Trusted Across Regulated Industries</h2>
        <p class="text-neutral-600 max-w-2xl mx-auto text-lg">
          Proofyx provides the evidence and accountability required by security and compliance teams worldwide.
        </p>
      </div>

      <!-- Trust Badges / Logos -->
      <div class="max-w-5xl mx-auto mb-20">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8 items-center transition-all">
          <div class="flex justify-center p-4">
            <div class="text-xl font-black text-neutral-600 tracking-tighter">GOV<span class="text-neutral-500">TECH</span></div>
          </div>
          <div class="flex justify-center p-4">
            <div class="text-xl font-black text-neutral-600 tracking-tighter italic">SECURE<span class="text-neutral-500">CORP</span></div>
          </div>
          <div class="flex justify-center p-4">
            <div class="text-xl font-black text-neutral-600 tracking-tighter">FIN<span class="text-neutral-500">ALLIANCE</span></div>
          </div>
          <div class="flex justify-center p-4">
            <div class="text-xl font-black text-neutral-600 tracking-tighter uppercase">Defense<span class="text-neutral-500">Systems</span></div>
          </div>
        </div>
        <p class="text-center text-neutral-600 text-xs mt-8 uppercase tracking-widest font-bold">Empowering Organizations Across Global Frameworks</p>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-8">
        {[
          { icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8"><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z" /></svg>`, title: "Security Teams" },
          { icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8"><path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 0 1 3 19.875v-6.75ZM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V8.625ZM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V4.125Z" /></svg>`, title: "Compliance" },
          { icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 8.25h19.5M2.25 9h19.5m-16.5 5.25h6m-6 2.25h3m-3.75-3h15a2.25 2.25 0 0 0 2.25-2.25V6.75A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25v3.375c0 .621.504 1.125 1.125 1.125Z" /></svg>`, title: "Fintech" },
          { icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-3h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21M3 3h12m-.75 4.5H21m-3.75 3.75h.008v.008h-.008v-.008Zm0 3h.008v.008h-.008v-.008Zm0 3h.008v.008h-.008v-.008Z" /></svg>`, title: "SaaS Platforms" },
          { icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 0 0-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 0 0-16.536-1.84M7.5 14.25 5.106 5.272M6 20.25a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm12.75 0a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z" /></svg>`, title: "eCommerce" },
          { icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v17.25m0 0c-1.472 0-2.882.265-4.185.75M12 20.25c1.472 0 2.882.265 4.185.75M18.75 4.97A48.416 48.416 0 0 0 12 4.5c-2.291 0-4.545.16-6.75.47m13.5 0c1.01.143 2.01.317 3 .52m-3-.52V12m0 0c1.01.143 2.01.317 3 .52m-3-.52c-2.147.116-4.416.476-6.504 1.076a4.502 4.502 0 0 1-2.992 0C8.416 13.476 6.147 13.116 4 13m14.75-1.03V4.97M12 4.5c1.01.143 2.01.317 3 .52M12 4.5c-1.01.143-2.01.317-3 .52M3 5.49c.99-.203 1.99-.377 3-.52m0 0V12m0 0c-1.01.143-2.01.317-3 .52m3-.52c2.147.116 4.416.476 6.504 1.076a4.502 4.502 0 0 0 2.992 0c2.088-.6 4.357-.96 6.504-1.076m-6.504 1.076V20.25m0 0a48.373 48.373 0 0 1-6.75-.47m6.75.47c2.291 0 4.545-.16 6.75-.47m-13.5 0c-1.01-.143-2.01-.317-3-.52m3 .52V12" /></svg>`, title: "Gov Contractors" }
        ].map(item => (
          <div class="text-center p-6 rounded-xl border border-neutral-100 bg-neutral-50 hover:bg-white hover:shadow-enterprise transition-all group">
            <div class="text-proofyx-blue mb-4 flex justify-center group-hover:scale-110 transition-transform" set:html={item.icon}></div>
            <h3 class="font-bold text-neutral-900 text-sm uppercase tracking-wider">{item.title}</h3>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- The Proofyx Advantage (Formerly Why Proofyx) -->
  <section class="py-24 bg-neutral-900 text-white relative overflow-hidden">
    <!-- Decor -->
    <div class="absolute top-0 right-0 w-1/2 h-full bg-gradient-to-l from-proofyx-blue/10 to-transparent"></div>
    
    <div class="container mx-auto px-6 relative z-10">
      <div class="max-w-3xl mb-16">
        <span class="inline-block px-4 py-1.5 bg-white/10 text-proofyx-blue-light text-xs font-bold uppercase tracking-widest rounded-full mb-6">
          The Platform Advantage
        </span>
        <h2 class="text-3xl md:text-5xl font-bold mb-6 text-white">Why choose Proofyx?</h2>
        <p class="text-white/70 text-lg leading-relaxed">
          We believe compliance is not complete until you can prove it. Our platform is engineered to eliminate ambiguity and build an unshakeable foundation for your next audit.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-x-12 gap-y-16">
        <div class="flex gap-6">
          <div class="w-12 h-12 bg-proofyx-blue/20 text-proofyx-blue rounded-xl flex items-center justify-center shrink-0 font-bold text-xl border border-proofyx-blue/30 shadow-[0_0_15px_rgba(37,99,235,0.2)]" role="img" aria-label="Checkmark">✓</div>
          <div>
            <h3 class="text-xl font-bold mb-3 text-white">Evidence-First Approach</h3>
            <p class="text-white/60 leading-relaxed">Every control and policy event is backed by verifiable evidence. No claims without proof.</p>
          </div>
        </div>

        <div class="flex gap-6">
          <div class="w-12 h-12 bg-proofyx-blue/20 text-proofyx-blue rounded-xl flex items-center justify-center shrink-0 font-bold text-xl border border-proofyx-blue/30 shadow-[0_0_15px_rgba(37,99,235,0.2)]" role="img" aria-label="Checkmark">✓</div>
          <div>
            <h3 class="text-xl font-bold mb-3 text-white">Clear Pass/Fail Visibility</h3>
            <p class="text-white/60 leading-relaxed">Know your status at a glance. Green means compliant, red means action required. No ambiguity.</p>
          </div>
        </div>

        <div class="flex gap-6">
          <div class="w-12 h-12 bg-proofyx-blue/20 text-proofyx-blue rounded-xl flex items-center justify-center shrink-0 font-bold text-xl border border-proofyx-blue/30 shadow-[0_0_15px_rgba(37,99,235,0.2)]" role="img" aria-label="Checkmark">✓</div>
          <div>
            <h3 class="text-xl font-bold mb-3 text-white">Built for Audits</h3>
            <p class="text-white/60 leading-relaxed">Complete audit trails, timestamped logs, and evidence attachments. Ready for assessors instantly.</p>
          </div>
        </div>

        <div class="flex gap-6">
          <div class="w-12 h-12 bg-proofyx-blue/20 text-proofyx-blue rounded-xl flex items-center justify-center shrink-0 font-bold text-xl border border-proofyx-blue/30 shadow-[0_0_15px_rgba(37,99,235,0.2)]" role="img" aria-label="Checkmark">✓</div>
          <div>
            <h3 class="text-xl font-bold mb-3 text-white">Regulated Environments</h3>
            <p class="text-white/60 leading-relaxed">Purpose-built for organizations that must definitively demonstrate compliance.</p>
          </div>
        </div>

        <div class="flex gap-6">
          <div class="w-12 h-12 bg-proofyx-blue/20 text-proofyx-blue rounded-xl flex items-center justify-center shrink-0 font-bold text-xl border border-proofyx-blue/30 shadow-[0_0_15px_rgba(37,99,235,0.2)]" role="img" aria-label="Checkmark">✓</div>
          <div>
            <h3 class="text-xl font-bold mb-3 text-white">Least Privilege Default</h3>
            <p class="text-white/60 leading-relaxed">Role-based access controls ensure users only see what they need. Security meets compliance.</p>
          </div>
        </div>

        <div class="flex gap-6">
          <div class="w-12 h-12 bg-proofyx-blue/20 text-proofyx-blue rounded-xl flex items-center justify-center shrink-0 font-bold text-xl border border-proofyx-blue/30 shadow-[0_0_15px_rgba(37,99,235,0.2)]" role="img" aria-label="Checkmark">✓</div>
          <div>
            <h3 class="text-xl font-bold mb-3 text-white">Complete Audit Trails</h3>
            <p class="text-white/60 leading-relaxed">Every action is logged with who, what, when, and why. Immutable records for verification.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact Section -->
  <section id="contact" class="py-24 bg-white">
    <div class="container mx-auto px-6">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div>
          <h2 class="text-3xl md:text-4xl font-bold text-neutral-900 mb-6">Get in Touch</h2>
          <p class="text-xl text-neutral-600 mb-8 leading-relaxed">
            Have questions about Proofyx? Our team of compliance experts is here to help you build audit-ready proof and streamline your policy lifecycle.
          </p>
          
          <div class="space-y-6">
            <div class="flex items-center gap-4 text-neutral-700">
              <div class="w-10 h-10 bg-proofyx-blue-light text-proofyx-blue rounded-full flex items-center justify-center shrink-0" role="img" aria-label="Checkmark">✓</div>
              <p>Demo requests and walkthroughs</p>
            </div>
            <div class="flex items-center gap-4 text-neutral-700">
              <div class="w-10 h-10 bg-proofyx-blue-light text-proofyx-blue rounded-full flex items-center justify-center shrink-0" role="img" aria-label="Checkmark">✓</div>
              <p>Framework guidance (CMMC, NIST, SOC2)</p>
            </div>
            <div class="flex items-center gap-4 text-neutral-700">
