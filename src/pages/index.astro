---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import CTASection from '../components/CTASection.astro';
import ContactForm from '../components/ContactForm.astro';
import DashboardMockup from '../components/DashboardMockup.astro';

const features = [
  {
    title: "Audit-Ready Evidence",
    description: "Centralize your proof with automated collection and mapping to major frameworks.",
    icon: "🛡️"
  },
  {
    title: "Policy Lifecycle",
    description: "Manage policies from creation to retirement with full version control and audit logs.",
    icon: "📋"
  },
  {
    title: "Framework Mapping",
    description: "Map evidence once and apply it across CMMC, NIST, SOC2, and more.",
    icon: "🗺️"
  }
];
---

<BaseLayout title="Home">
  <!-- Hero Section -->
  <section class="relative bg-[#0a1929] pt-32 pb-48 overflow-hidden">
    <div class="container mx-auto px-6 relative z-10 grid md:grid-cols-2 gap-12 items-center">
      <div>
        <h1 class="text-5xl md:text-6xl font-bold text-white mb-8 leading-tight">
          Compliance Proof <br /><span class="text-proofyx-blue-light">Built for Audits.</span>
        </h1>
        <p class="text-xl text-white/80 mb-10 leading-relaxed max-w-xl">
          Move beyond spreadsheets. Proofyx centralizes your evidence, policies, and compliance workflows for organizations that can't afford to fail an audit.
        </p>
        <div class="flex flex-wrap gap-4">
          <button onclick="document.getElementById('get-started').scrollIntoView({behavior: 'smooth'})" class="bg-proofyx-blue text-white px-8 py-4 rounded-md text-lg font-semibold hover:bg-proofyx-blue-dark transition-all">Get Started</button>
          <Button href="/compliance" variant="outline" size="lg" class="!border-white/20 !text-white hover:!bg-white/10">Explore Compliance</Button>
        </div>
      </div>
      <div class="hidden md:block">
        <DashboardMockup />
      </div>
    </div>
    
    <!-- Background Decor -->
    <div class="absolute -top-24 -right-24 w-96 h-96 bg-proofyx-blue/20 rounded-full blur-3xl"></div>
    <div class="absolute -bottom-24 -left-24 w-96 h-96 bg-proofyx-green/10 rounded-full blur-3xl"></div>
  </section>

  <!-- Feature Grid -->
  <section class="py-24 bg-white">
    <div class="container mx-auto px-6">
      <div class="text-center mb-20">
        <h2 class="text-3xl md:text-4xl font-bold text-neutral-900 mb-4">Enterprise Compliance Management</h2>
        <p class="text-neutral-600 max-w-2xl mx-auto text-lg">
          Everything you need to manage your compliance posture and policy lifecycle in one unified platform.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-12">
        {features.map(feature => (
          <div class="group p-8 rounded-xl border border-neutral-100 bg-neutral-50 hover:bg-white hover:shadow-enterprise-hover hover:border-proofyx-blue/20 transition-all duration-300">
            <div class="text-4xl mb-6">{feature.icon}</div>
            <h3 class="text-xl font-bold mb-4 group-hover:text-proofyx-blue transition-colors">{feature.title}</h3>
            <p class="text-neutral-600 leading-relaxed">{feature.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Choose Your Starting Point Section -->
  <section id="get-started" class="py-24 bg-neutral-50 scroll-mt-20">
    <div class="container mx-auto px-6">
      <div class="text-center mb-20">
        <h2 class="text-3xl md:text-4xl font-bold text-neutral-900 mb-4">Choose Your Starting Point</h2>
        <p class="text-neutral-600 max-w-2xl mx-auto text-lg">
          Select the product that best fits your needs. Each application is designed to help you build audit-ready proof.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-12">
        <!-- Compliance Card -->
        <div class="bg-white border border-neutral-200 rounded-2xl p-10 hover:shadow-enterprise-hover transition-all group relative overflow-hidden flex flex-col">
          <div class="absolute top-0 left-0 w-full h-1 bg-proofyx-blue"></div>
          <div class="flex items-center gap-3 mb-6">
            <div class="w-10 h-10 bg-proofyx-blue-light text-proofyx-blue rounded flex items-center justify-center font-bold">✓</div>
            <span class="text-xs font-bold text-proofyx-blue uppercase tracking-widest">FOUNDATION · Controls & Evidence</span>
          </div>
          <h3 class="text-3xl font-bold mb-6">Compliance Management</h3>
          <p class="text-neutral-600 mb-8 text-lg">
            Guide and track compliance requirements into audit-ready proof.
          </p>
          <ul class="space-y-3 mb-10 flex-grow">
            <li class="flex items-start gap-3 text-neutral-700">
              <span class="text-proofyx-blue font-bold">•</span>
              <span><b>Guided</b> control mapping (CMMC 2.0 & future frameworks)</span>
            </li>
            <li class="flex items-start gap-3 text-neutral-700">
              <span class="text-proofyx-blue font-bold">•</span>
              <span><b>Real-time</b> compliance status tracking</span>
            </li>
          </ul>
          <div class="flex gap-4">
            <Button href="https://compliance.proofyx.com" class="flex-grow">Get Started</Button>
            <Button href="/compliance" variant="outline" class="flex-grow">Learn More</Button>
          </div>
        </div>

        <!-- Policy Card -->
        <div class="bg-white border border-neutral-200 rounded-2xl p-10 hover:shadow-enterprise-hover transition-all group relative overflow-hidden flex flex-col">
          <div class="absolute top-0 left-0 w-full h-1 bg-proofyx-green"></div>
          <div class="flex items-center gap-3 mb-6">
            <div class="w-10 h-10 bg-proofyx-green/10 text-proofyx-green rounded flex items-center justify-center font-bold">📋</div>
            <span class="text-xs font-bold text-proofyx-green uppercase tracking-widest">GOVERNANCE · Policies & Accountability</span>
          </div>
          <h3 class="text-3xl font-bold mb-6">Policy Management</h3>
          <p class="text-neutral-600 mb-8 text-lg">
            Define intent. Enforce accountability. Prove alignment.
          </p>
          <ul class="space-y-3 mb-10 flex-grow">
            <li class="flex items-start gap-3 text-neutral-700">
              <span class="text-proofyx-green font-bold">•</span>
              <span><b>Policy lifecycle</b> (Author, Approve, Version)</span>
            </li>
            <li class="flex items-start gap-3 text-neutral-700">
              <span class="text-proofyx-green font-bold">•</span>
              <span><b>Full audit history</b> and ownership tracking</span>
            </li>
          </ul>
          <div class="flex gap-4">
            <Button href="https://policy.proofyx.com" class="flex-grow !bg-proofyx-green hover:!bg-green-700">Get Started</Button>
            <Button href="/policy" variant="outline" class="flex-grow !border-proofyx-green !text-proofyx-green hover:!bg-proofyx-green/5">Learn More</Button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Built For Compliance Teams -->
  <section class="py-24 bg-white border-b border-neutral-100">
    <div class="container mx-auto px-6">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-neutral-900 mb-4">Trusted Across Regulated Industries</h2>
        <p class="text-neutral-600 max-w-2xl mx-auto text-lg">
          Proofyx provides the evidence and accountability required by security and compliance teams worldwide.
        </p>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-8">
        {[
          { icon: "🔒", title: "Security Teams" },
          { icon: "📊", title: "Compliance" },
          { icon: "💳", title: "Fintech" },
          { icon: "🏢", title: "SaaS Platforms" },
          { icon: "🛒", title: "eCommerce" },
          { icon: "⚖️", title: "Gov Contractors" }
        ].map(item => (
          <div class="text-center p-6 rounded-xl border border-neutral-100 bg-neutral-50 hover:bg-white hover:shadow-enterprise transition-all">
            <div class="text-4xl mb-4">{item.icon}</div>
            <h4 class="font-bold text-neutral-900 text-sm uppercase tracking-wider">{item.title}</h4>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- The Proofyx Advantage (Formerly Why Proofyx) -->
  <section class="py-24 bg-neutral-900 text-white relative overflow-hidden">
    <!-- Decor -->
    <div class="absolute top-0 right-0 w-1/2 h-full bg-gradient-to-l from-proofyx-blue/10 to-transparent"></div>
    
    <div class="container mx-auto px-6 relative z-10">
      <div class="max-w-3xl mb-16">
        <span class="inline-block px-4 py-1.5 bg-white/10 text-proofyx-blue-light text-xs font-bold uppercase tracking-widest rounded-full mb-6">
          The Platform Advantage
        </span>
        <h2 class="text-3xl md:text-5xl font-bold mb-6 text-white">Why choose Proofyx?</h2>
        <p class="text-white/70 text-lg leading-relaxed">
          We believe compliance is not complete until you can prove it. Our platform is engineered to eliminate ambiguity and build an unshakeable foundation for your next audit.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-x-12 gap-y-16">
        <div class="flex gap-6">
          <div class="w-12 h-12 bg-proofyx-blue/20 text-proofyx-blue rounded-xl flex items-center justify-center shrink-0 font-bold text-xl border border-proofyx-blue/30 shadow-[0_0_15px_rgba(37,99,235,0.2)]">✓</div>
          <div>
            <h4 class="text-xl font-bold mb-3 text-white">Evidence-First Approach</h4>
            <p class="text-white/60 leading-relaxed">Every control and policy event is backed by verifiable evidence. No claims without proof.</p>
          </div>
        </div>

        <div class="flex gap-6">
          <div class="w-12 h-12 bg-proofyx-blue/20 text-proofyx-blue rounded-xl flex items-center justify-center shrink-0 font-bold text-xl border border-proofyx-blue/30 shadow-[0_0_15px_rgba(37,99,235,0.2)]">✓</div>
          <div>
            <h4 class="text-xl font-bold mb-3 text-white">Clear Pass/Fail Visibility</h4>
            <p class="text-white/60 leading-relaxed">Know your status at a glance. Green means compliant, red means action required. No ambiguity.</p>
          </div>
        </div>

        <div class="flex gap-6">
          <div class="w-12 h-12 bg-proofyx-blue/20 text-proofyx-blue rounded-xl flex items-center justify-center shrink-0 font-bold text-xl border border-proofyx-blue/30 shadow-[0_0_15px_rgba(37,99,235,0.2)]">✓</div>
          <div>
            <h4 class="text-xl font-bold mb-3 text-white">Built for Audits</h4>
            <p class="text-white/60 leading-relaxed">Complete audit trails, timestamped logs, and evidence attachments. Ready for assessors instantly.</p>
          </div>
        </div>

        <div class="flex gap-6">
          <div class="w-12 h-12 bg-proofyx-blue/20 text-proofyx-blue rounded-xl flex items-center justify-center shrink-0 font-bold text-xl border border-proofyx-blue/30 shadow-[0_0_15px_rgba(37,99,235,0.2)]">✓</div>
          <div>
            <h4 class="text-xl font-bold mb-3 text-white">Regulated Environments</h4>
            <p class="text-white/60 leading-relaxed">Purpose-built for organizations that must definitively demonstrate compliance.</p>
          </div>
        </div>

        <div class="flex gap-6">
          <div class="w-12 h-12 bg-proofyx-blue/20 text-proofyx-blue rounded-xl flex items-center justify-center shrink-0 font-bold text-xl border border-proofyx-blue/30 shadow-[0_0_15px_rgba(37,99,235,0.2)]">✓</div>
          <div>
            <h4 class="text-xl font-bold mb-3 text-white">Least Privilege Default</h4>
            <p class="text-white/60 leading-relaxed">Role-based access controls ensure users only see what they need. Security meets compliance.</p>
          </div>
        </div>

        <div class="flex gap-6">
          <div class="w-12 h-12 bg-proofyx-blue/20 text-proofyx-blue rounded-xl flex items-center justify-center shrink-0 font-bold text-xl border border-proofyx-blue/30 shadow-[0_0_15px_rgba(37,99,235,0.2)]">✓</div>
          <div>
            <h4 class="text-xl font-bold mb-3 text-white">Complete Audit Trails</h4>
            <p class="text-white/60 leading-relaxed">Every action is logged with who, what, when, and why. Immutable records for verification.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact Section -->
  <section id="contact" class="py-24 bg-white">
    <div class="container mx-auto px-6">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div>
          <h2 class="text-3xl md:text-4xl font-bold text-neutral-900 mb-6">Get in Touch</h2>
          <p class="text-xl text-neutral-600 mb-8 leading-relaxed">
            Have questions about Proofyx? Our team of compliance experts is here to help you build audit-ready proof and streamline your policy lifecycle.
          </p>
          
          <div class="space-y-6">
            <div class="flex items-center gap-4 text-neutral-700">
              <div class="w-10 h-10 bg-proofyx-blue-light text-proofyx-blue rounded-full flex items-center justify-center shrink-0">✓</div>
              <p>Demo requests and walkthroughs</p>
            </div>
            <div class="flex items-center gap-4 text-neutral-700">
              <div class="w-10 h-10 bg-proofyx-blue-light text-proofyx-blue rounded-full flex items-center justify-center shrink-0">✓</div>
              <p>Framework guidance (CMMC, NIST, SOC2)</p>
            </div>
            <div class="flex items-center gap-4 text-neutral-700">
              <div class="w-10 h-10 bg-proofyx-blue-light text-proofyx-blue rounded-full flex items-center justify-center shrink-0">✓</div>
              <p>Enterprise support and onboarding</p>
            </div>
          </div>
        </div>
        
        <div>
          <ContactForm />
        </div>
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>
