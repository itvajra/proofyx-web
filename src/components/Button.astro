---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'outline';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
}

const { 
  href, 
  variant = 'primary', 
  size = 'md', 
  class: className,
  ...rest 
} = Astro.props;

const variants = {
  primary: 'bg-proofyx-blue text-white hover:bg-proofyx-blue-dark shadow-sm hover:shadow-md transition-all duration-200',
  secondary: 'bg-proofyx-blue-light text-proofyx-blue hover:bg-blue-100 transition-all duration-200',
  outline: 'bg-transparent border-2 border-proofyx-blue text-proofyx-blue hover:bg-proofyx-blue-light transition-all duration-200',
};

const sizes = {
  sm: 'px-4 py-2 text-sm',
  md: 'px-6 py-3 text-base',
  lg: 'px-8 py-4 text-lg font-semibold',
};

const Element = href ? 'a' : 'button';
---

<Element
  href={href}
  class:list={[
    'inline-flex items-center justify-center rounded-md font-medium text-center',
    variants[variant],
    sizes[size],
    className
  ]}
  {...rest}
>
  <slot />
</Element>
