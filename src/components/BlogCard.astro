---
import { Image } from 'astro:assets';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  category: string;
  readingTime: string;
  slug: string;
  image?: any;
  isFeatured?: boolean;
}

const { title, description, pubDate, category, readingTime, slug, image, isFeatured = false } = Astro.props;

const formattedDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(pubDate);
---

<article class:list={[
  "bg-white border border-neutral-200 rounded-lg overflow-hidden transition-all duration-300 hover:shadow-enterprise-hover group",
  isFeatured ? "md:grid md:grid-cols-2 gap-0 p-0" : "flex flex-col h-full"
]}>
  <div class:list={[
    "bg-neutral-100 flex items-center justify-center overflow-hidden relative",
    isFeatured ? "aspect-video md:aspect-auto" : "aspect-video"
  ]}>
    {image ? (
      <Image 
        src={image} 
        alt={title} 
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
      />
    ) : (
      <div class="w-full h-full bg-gradient-to-br from-neutral-50 to-neutral-200 flex items-center justify-center relative overflow-hidden">
        <div class="absolute inset-0 opacity-[0.03]" style="background-image: radial-gradient(#1e4da2 1px, transparent 1px); background-size: 20px 20px;"></div>
        <div class="relative z-10 text-proofyx-blue opacity-10 group-hover:scale-110 group-hover:opacity-20 transition-all duration-500">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-24 h-24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.333 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" />
          </svg>
        </div>
      </div>
    )}
  </div>
  
  <div class:list={[
    "p-8 flex flex-col h-full",
    isFeatured ? "justify-center" : ""
  ]}>
    <div class="flex items-center gap-3 mb-4">
      <span class="text-xs font-bold uppercase tracking-wider text-proofyx-blue px-2.5 py-1 bg-proofyx-blue-light rounded">
        {category}
      </span>
      <span class="text-neutral-400 text-xs">•</span>
      <time datetime={pubDate.toISOString()} class="text-neutral-500 text-xs">{formattedDate}</time>
    </div>

    <h3 class:list={[
      "font-bold text-neutral-900 group-hover:text-proofyx-blue transition-colors mb-4 leading-tight",
      isFeatured ? "text-3xl md:text-4xl" : "text-xl"
    ]}>
      <a href={`/blog/${slug}`} class="no-underline">
        {title}
      </a>
    </h3>

    <p class:list={[
      "text-neutral-600 mb-8 line-clamp-3",
      isFeatured ? "text-lg" : "text-sm"
    ]}>
      {description}
    </p>

    <div class="mt-auto flex items-center justify-between">
      <span class="text-neutral-500 text-xs font-medium">{readingTime}</span>
      <a href={`/blog/${slug}`} class="text-proofyx-blue text-sm font-bold flex items-center gap-1 group-hover:gap-2 transition-all" aria-label={`Read more about ${title}`}>
        Read More <span>→</span>
      </a>
    </div>
  </div>
</article>
