---
---

<div class="relative w-full max-w-2xl mx-auto">
  <!-- Glow Effect -->
  <div class="absolute -inset-4 bg-gradient-to-tr from-proofyx-blue/30 to-proofyx-green/20 rounded-[2.5rem] blur-2xl opacity-50"></div>
  
  <!-- Main Dashboard Container -->
  <div class="relative bg-white rounded-3xl shadow-2xl border border-neutral-200 overflow-hidden flex h-[500px] transform md:rotate-2 hover:rotate-0 transition-all duration-700 group">
    
    <!-- Sidebar -->
    <div class="w-48 bg-neutral-900 flex flex-col p-6">
      <div class="mb-10">
        <img src="/images/logo.png" alt="Proofyx" class="h-6 w-auto brightness-0 invert" width="84" height="24" />
      </div>
      
      <nav class="space-y-6">
        <div class="flex items-center gap-3 opacity-100">
          <div class="w-2 h-2 bg-proofyx-blue rounded-full"></div>
          <span class="text-xs font-bold text-white uppercase tracking-widest">Dashboard</span>
        </div>
        <div class="flex items-center gap-3 opacity-40">
          <div class="w-2 h-2 bg-white rounded-full"></div>
          <span class="text-xs font-bold text-white uppercase tracking-widest">Evidence</span>
        </div>
        <div class="flex items-center gap-3 opacity-40">
          <div class="w-2 h-2 bg-white rounded-full"></div>
          <span class="text-xs font-bold text-white uppercase tracking-widest">Policies</span>
        </div>
        <div class="flex items-center gap-3 opacity-40">
          <div class="w-2 h-2 bg-white rounded-full"></div>
          <span class="text-xs font-bold text-white uppercase tracking-widest">Audits</span>
        </div>
      </nav>
      
      <div class="mt-auto">
        <div class="h-8 w-full bg-white/10 rounded-md"></div>
      </div>
    </div>
    
    <!-- Main Content Area -->
    <div class="flex-grow bg-neutral-50 p-8 overflow-hidden">
      <header class="flex justify-between items-center mb-10">
        <div>
          <h4 class="text-xl font-bold text-neutral-900">Compliance Overview</h4>
          <p class="text-[10px] text-neutral-400 font-medium uppercase tracking-tighter">System Status: <span class="text-proofyx-green font-bold">Audit Ready</span></p>
        </div>
        <div class="flex gap-2">
          <div class="w-8 h-8 bg-white border border-neutral-200 rounded-full"></div>
          <div class="w-8 h-8 bg-white border border-neutral-200 rounded-full"></div>
        </div>
      </header>
      
      <div class="grid grid-cols-2 gap-6">
        <!-- Trust Score Widget -->
        <div class="bg-white p-6 rounded-2xl border border-neutral-100 shadow-sm flex flex-col items-center justify-center text-center">
          <div class="relative w-24 h-24 mb-4">
            <svg class="w-full h-full transform -rotate-90">
              <circle cx="48" cy="48" r="40" stroke="currentColor" stroke-width="8" fill="transparent" class="text-neutral-100" />
              <circle cx="48" cy="48" r="40" stroke="currentColor" stroke-width="8" fill="transparent" stroke-dasharray="251.2" stroke-dashoffset="30" class="text-proofyx-blue transition-all duration-1000" />
            </svg>
            <div class="absolute inset-0 flex items-center justify-center">
              <span class="text-2xl font-bold text-neutral-900">88%</span>
            </div>
          </div>
          <p class="text-[10px] font-bold text-neutral-400 uppercase tracking-widest">Overall Trust Score</p>
        </div>
        
        <!-- Framework Status Widget -->
        <div class="bg-white p-6 rounded-2xl border border-neutral-100 shadow-sm">
          <p class="text-[10px] font-bold text-neutral-400 uppercase tracking-widest mb-4">Framework Progress</p>
          <div class="space-y-4">
            <div>
              <div class="flex justify-between text-[10px] font-bold mb-1">
                <span>CMMC 2.0</span>
                <span>92%</span>
              </div>
              <div class="h-1.5 w-full bg-neutral-100 rounded-full overflow-hidden">
                <div class="h-full bg-proofyx-blue w-[92%]"></div>
              </div>
            </div>
            <div>
              <div class="flex justify-between text-[10px] font-bold mb-1">
                <span>NIST 800-171</span>
                <span>85%</span>
              </div>
              <div class="h-1.5 w-full bg-neutral-100 rounded-full overflow-hidden">
                <div class="h-full bg-proofyx-green w-[85%]"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Evidence List -->
      <div class="mt-8">
        <p class="text-[10px] font-bold text-neutral-400 uppercase tracking-widest mb-4">Recent Audit-Ready Proof</p>
        <div class="space-y-3">
          <div class="flex items-center justify-between p-3 bg-white border border-neutral-100 rounded-lg">
            <div class="flex items-center gap-3">
              <div class="w-5 h-5 bg-proofyx-blue/10 text-proofyx-blue rounded flex items-center justify-center text-[10px] font-bold">✓</div>
              <span class="text-[11px] font-medium text-neutral-700">MFA Implementation Logs</span>
            </div>
            <span class="text-[10px] text-neutral-400 font-mono">14:02:11</span>
          </div>
          <div class="flex items-center justify-between p-3 bg-white border border-neutral-100 rounded-lg">
            <div class="flex items-center gap-3">
              <div class="w-5 h-5 bg-proofyx-blue/10 text-proofyx-blue rounded flex items-center justify-center text-[10px] font-bold">✓</div>
              <span class="text-[11px] font-medium text-neutral-700">Access Control Policy v2.1</span>
            </div>
            <span class="text-[10px] text-neutral-400 font-mono">12:45:04</span>
          </div>
          <div class="flex items-center justify-between p-3 bg-white border border-neutral-100 rounded-lg">
            <div class="flex items-center gap-3">
              <div class="w-5 h-5 bg-proofyx-blue/10 text-proofyx-blue rounded flex items-center justify-center text-[10px] font-bold">✓</div>
              <span class="text-[11px] font-medium text-neutral-700">Vendor Risk Assessment</span>
            </div>
            <span class="text-[10px] text-neutral-400 font-mono">Yesterday</span>
          </div>
        </div>
      </div>
    </div>
    
    <!-- Cursor Decoration -->
    <div class="absolute bottom-20 right-40 w-8 h-8 bg-proofyx-blue/20 rounded-full flex items-center justify-center border border-proofyx-blue/40 animate-bounce">
       <div class="w-2 h-2 bg-proofyx-blue rounded-full"></div>
    </div>
  </div>
</div>
