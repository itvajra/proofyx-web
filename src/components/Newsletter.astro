---
import Button from './Button.astro';
---

<section class="py-16 bg-proofyx-blue rounded-3xl overflow-hidden relative">
  <!-- Decor -->
  <div class="absolute -top-24 -right-24 w-64 h-64 bg-white/10 rounded-full blur-3xl"></div>
  <div class="absolute -bottom-24 -left-24 w-64 h-64 bg-proofyx-green/20 rounded-full blur-3xl"></div>

  <div class="container mx-auto px-8 relative z-10">
    <div class="max-w-4xl mx-auto flex flex-col md:flex-row items-center justify-between gap-12">
      <div class="text-center md:text-left">
        <h2 class="text-3xl font-bold text-white mb-4">Stay ahead of compliance</h2>
        <p class="text-white/80 text-lg">
          Get the latest CMMC updates, audit prep guides, and policy best practices delivered to your inbox.
        </p>
      </div>
      
      <div class="w-full md:w-auto shrink-0">
        <form class="flex flex-col sm:flex-row gap-3">
          <input 
            type="email" 
            placeholder="Work email address" 
            required
            class="px-6 py-4 rounded-md bg-white border border-transparent focus:outline-none focus:ring-2 focus:ring-proofyx-blue-light min-w-[300px] text-neutral-900"
          />
          <Button variant="secondary" size="lg" class="whitespace-nowrap">Subscribe</Button>
        </form>
        <p class="text-white/40 text-xs mt-3 text-center md:text-left">
          No fluff. Only technical compliance insights. Unsubscribe anytime.
        </p>
      </div>
    </div>
  </div>
</section>
