---
/**
 * Newsletter.astro
 * Brevo newsletter sign-up form, styled to match the Proofyx design system.
 */

interface Props {
  heading?: string;
  subtext?: string;
}

const {
  heading = "Compliance Insights Backed by Proof",
  subtext = "Practical guidance on CMMC, audit readiness, evidence tracking, and compliance operations.",
} = Astro.props;
---

<section class="newsletter-section">
  <div class="newsletter-decor-1"></div>
  <div class="newsletter-decor-2"></div>

  <div class="newsletter-inner">
    <div class="newsletter-card">
      <!-- Content Column -->
      <div class="newsletter-content">
        <span class="newsletter-badge">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 17a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V9.5C2 7 4 5 6.5 5H17.5C20 5 22 7 22 9.5V17Z"></path>
            <path d="m22 7-10 7L2 7"></path>
          </svg>
          Direct to Inbox
        </span>
        <h2 class="newsletter-heading">{heading}</h2>
        <p class="newsletter-subtext">{subtext}</p>
      </div>

      <!-- Form Column -->
      <div class="newsletter-form-container">
        <div class="brevo-wrap">
          <div id="sib-form-container" class="sib-form-container">
            <!-- Messages -->
            <div id="error-message" class="sib-form-message-panel error-panel">
               <div class="sib-form-message-panel__text">Your subscription could not be saved. Please try again.</div>
            </div>
            <div id="success-message" class="sib-form-message-panel success-panel">
               <div class="sib-form-message-panel__text">You're subscribed! Check your inbox to confirm.</div>
            </div>

            <div id="sib-container">
              <form id="sib-form" method="POST" action="https://7e4e4106.sibforms.com/serve/MUIFAEUak_PICjKoWufnhLULj0ByRtFPKI-UBPVmSPEbrE2td5s4w9VIBOcnAr8VGF7Trc701nourkbkl_hnFGbmIwYz6xlVy01EzrcUaSN2Zelq2SEBb26Idgb1lmKN-Q3i4wNOzlVs4efU2s2tTx4P9FeGx9eprUGI97HdVLi-3q75kD8Se1RapwokWduD2G0oPI98ghI8dd1Z" data-type="subscription">
                <!-- Input Block -->
                <div class="sib-input sib-form-block">
                  <div class="form__entry input-wrapper">
                    <div class="input-icon">
                      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                        <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
                      </svg>
                    </div>
                    <input class="input" type="text" id="EMAIL" name="EMAIL" autocomplete="off" placeholder="Email address" data-required="true" required />
                    <label class="entry__error entry__error--primary" style="display:none;"></label>
                  </div>
                </div>

                <!-- Submit Block -->
                <div class="sib-form-block">
                  <button class="sib-form-block__button" form="sib-form" type="submit">
                    Subscribe
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <line x1="5" y1="12" x2="19" y2="12"></line>
                      <polyline points="12 5 19 12 12 19"></polyline>
                    </svg>
                  </button>
                </div>

                <!-- Hidden Fields -->
                <input type="text" name="email_address_check" value="" class="input--hidden" style="display:none !important;">
                <input type="hidden" name="locale" value="en">
                <div class="g-recaptcha" data-sitekey="6LeKWuYsAAAAAA9TWyDS95FSEP-hmgBlQ4kCnGDo" data-callback="invisibleCaptchaCallback" data-size="invisible"></div>
              </form>
            </div>
          </div>
        </div>
        <p class="newsletter-disclaimer">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          </svg>
          Privacy first. No spam. Unsubscribe anytime.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  /* ── Newsletter Section ── */
  .newsletter-section {
    padding: 6rem 1.5rem;
    position: relative;
    overflow: hidden;
    background: #0a0f1e;
    color: #ffffff;
    font-family: Inter, system-ui, sans-serif;
  }

  .newsletter-decor-1 {
    position: absolute;
    top: -10%;
    right: -5%;
    width: 40%;
    height: 60%;
    background: radial-gradient(circle, rgba(37, 99, 235, 0.15) 0%, transparent 70%);
    filter: blur(80px);
    pointer-events: none;
  }

  .newsletter-decor-2 {
    position: absolute;
    bottom: -10%;
    left: -5%;
    width: 30%;
    height: 50%;
    background: radial-gradient(circle, rgba(16, 185, 129, 0.1) 0%, transparent 70%);
    filter: blur(80px);
    pointer-events: none;
  }

  .newsletter-inner {
    max-width: 1100px;
    margin: 0 auto;
    position: relative;
    z-index: 10;
  }

  .newsletter-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 2rem;
    padding: 4rem;
    backdrop-filter: blur(24px);
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 5rem;
    align-items: center;
    box-shadow: 0 20px 50px -12px rgba(0, 0, 0, 0.6);
    position: relative;
    overflow: hidden;
  }

  @media (max-width: 992px) {
    .newsletter-card {
      grid-template-columns: 1fr;
      padding: 3rem 2rem;
      gap: 3rem;
      text-align: center;
    }
  }

  .newsletter-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(37, 99, 235, 0.15);
    color: #93c5fd;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    padding: 0.6rem 1.2rem;
    border-radius: 100px;
    margin-bottom: 1.5rem;
    border: 1px solid rgba(37, 99, 235, 0.3);
  }

  .newsletter-heading {
    font-size: clamp(2.25rem, 4.5vw, 3rem);
    font-weight: 800;
    color: #ffffff;
    line-height: 1.05;
    margin: 0 0 1.5rem 0;
    letter-spacing: -0.03em;
  }

  .newsletter-subtext {
    font-size: 1.125rem;
    color: rgba(255, 255, 255, 0.7);
    line-height: 1.6;
    margin: 0;
    max-width: 500px;
  }

  .newsletter-form-container {
    width: 100%;
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .brevo-wrap {
    width: 100%;
  }

  .brevo-wrap .sib-form {
    background: transparent !important;
    padding: 0 !important;
  }

  /* Hide Brevo text blocks */
  .brevo-wrap .sib-text-form-block,
  .brevo-wrap .sib-form-block p {
    display: none !important;
  }

  .brevo-wrap #sib-container {
    background: transparent !important;
    border: none !important;
    padding: 0 !important;
    max-width: 100% !important;
  }

  .input-wrapper {
    position: relative;
    width: 100%;
  }

  .input-icon {
    position: absolute;
    left: 1.25rem;
    top: 50%;
    transform: translateY(-50%);
    color: rgba(255, 255, 255, 0.4);
    pointer-events: none;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .brevo-wrap .input {
    width: 100% !important;
    background: rgba(255, 255, 255, 0.05) !important;
    border: 1px solid rgba(255, 255, 255, 0.15) !important;
    border-radius: 1rem !important;
    padding: 1.25rem 1.5rem 1.25rem 3.5rem !important;
    color: #ffffff !important;
    font-size: 1rem !important;
    transition: all 0.3s ease !important;
    box-sizing: border-box;
  }

  .brevo-wrap .input:focus {
    background: rgba(255, 255, 255, 0.08) !important;
    border-color: #3b82f6 !important;
    outline: none !important;
    box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.2) !important;
  }

  .input-wrapper:focus-within .input-icon {
    color: #3b82f6;
  }

  .brevo-wrap .sib-form-block__button {
    width: 100% !important;
    background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%) !important;
    color: #ffffff !important;
    border: none !important;
    border-radius: 1rem !important;
    padding: 1.25rem 2rem !important;
    font-size: 1.05rem !important;
    font-weight: 700 !important;
    cursor: pointer !important;
    transition: all 0.3s ease !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 0.75rem !important;
    margin-top: 1rem !important;
  }

  .brevo-wrap .sib-form-block__button:hover {
    transform: translateY(-2px) !important;
    filter: brightness(1.1) !important;
    box-shadow: 0 10px 20px rgba(37, 99, 235, 0.4) !important;
  }

  .sib-form-message-panel {
    display: none;
    border-radius: 1rem !important;
    padding: 1.25rem !important;
    margin-bottom: 2rem !important;
  }

  .success-panel {
    background: rgba(16, 185, 129, 0.1) !important;
    color: #34d399 !important;
    border: 1px solid rgba(16, 185, 129, 0.2) !important;
  }

  .error-panel {
    background: rgba(239, 68, 68, 0.1) !important;
    color: #fca5a5 !important;
    border: 1px solid rgba(239, 68, 68, 0.2) !important;
  }

  .newsletter-disclaimer {
    margin-top: 1.5rem;
    margin-bottom: 3rem; /* Add space below for the recaptcha badge */
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.45);
    text-align: center;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }

  /* Center reCAPTCHA badge within the form column */
  :global(.grecaptcha-badge) {
    position: absolute !important;
    bottom: 0 !important;
    left: 50% !important;
    transform: translateX(-50%) scale(0.7) !important;
    box-shadow: none !important;
    border-radius: 4px !important;
    overflow: hidden !important;
    z-index: 100 !important;
    opacity: 0.5 !important;
    transition: opacity 0.3s ease, transform 0.3s ease !important;
    border: 1px solid rgba(255, 255, 255, 0.1) !important;
    transform-origin: center bottom !important;
  }

  :global(.grecaptcha-badge:hover) {
    opacity: 1 !important;
    transform: translateX(-50%) scale(0.75) !important;
  }
</style>

<script is:inline>
  window.REQUIRED_CODE_ERROR_MESSAGE = 'Please choose a country code';
  window.LOCALE = 'en';
  window.EMAIL_INVALID_MESSAGE = window.SMS_INVALID_MESSAGE = "The information provided is invalid.";
  window.REQUIRED_ERROR_MESSAGE = "This field cannot be left blank.";
  window.GENERIC_INVALID_MESSAGE = "The information provided is invalid.";
  window.translation = {
    common: {
      selectedList: '{quantity} list selected',
      selectedLists: '{quantity} lists selected',
      selectedOption: '{quantity} selected',
      selectedOptions: '{quantity} selected',
    }
  };
</script>

<script defer src="https://sibforms.com/forms/end-form/build/main.js"></script>
<script src="https://www.google.com/recaptcha/api.js?hl=en" async defer></script>
