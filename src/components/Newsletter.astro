---
/**
 * Newsletter.astro
 * Premium Zero-Conflict Version - Embeds the official Brevo form via an isolated iframe
 * to bypass 401 errors and script conflicts.
 */

interface Props {
  heading?: string;
  subtext?: string;
}

const {
  heading = "Compliance Insights Backed by Proof",
  subtext = "Practical guidance on CMMC, audit readiness, evidence tracking, and compliance operations.",
} = Astro.props;
---

<section class="newsletter-section">
  <div class="newsletter-decor-1"></div>
  <div class="newsletter-decor-2"></div>

  <div class="newsletter-inner">
    <div class="newsletter-card">
      <!-- Content Column -->
      <div class="newsletter-content">
        <span class="newsletter-badge">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 17a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V9.5C2 7 4 5 6.5 5H17.5C20 5 22 7 22 9.5V17Z"></path>
            <path d="m22 7-10 7L2 7"></path>
          </svg>
          Direct to Inbox
        </span>
        <h2 class="newsletter-heading">{heading}</h2>
        <p class="newsletter-subtext">{subtext}</p>
      </div>

      <!-- Form Column (Isolated Iframe) -->
      <div class="newsletter-form-container">
        <div class="iframe-wrapper">
          <iframe 
            src="/newsletter-form.html" 
            title="Newsletter Subscription Form"
            class="newsletter-iframe"
            scrolling="no"
            loading="lazy"
          ></iframe>
        </div>
        
        <p class="newsletter-disclaimer">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          </svg>
          Privacy first. No spam. Unsubscribe anytime.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .newsletter-section {
    padding: 6rem 1.5rem;
    position: relative;
    overflow: hidden;
    background: #0a0f1e;
    color: #ffffff;
    font-family: Inter, system-ui, sans-serif;
  }

  .newsletter-decor-1 {
    position: absolute;
    top: -10%;
    right: -5%;
    width: 40%;
    height: 60%;
    background: radial-gradient(circle, rgba(37, 99, 235, 0.15) 0%, transparent 70%);
    filter: blur(80px);
    pointer-events: none;
  }

  .newsletter-decor-2 {
    position: absolute;
    bottom: -10%;
    left: -5%;
    width: 30%;
    height: 50%;
    background: radial-gradient(circle, rgba(16, 185, 129, 0.1) 0%, transparent 70%);
    filter: blur(80px);
    pointer-events: none;
  }

  .newsletter-inner {
    max-width: 1100px;
    margin: 0 auto;
    position: relative;
    z-index: 10;
  }

  .newsletter-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 2rem;
    padding: 4rem;
    backdrop-filter: blur(24px);
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 5rem;
    align-items: center;
    box-shadow: 0 20px 50px -12px rgba(0, 0, 0, 0.6);
    position: relative;
  }

  @media (max-width: 992px) {
    .newsletter-card {
      grid-template-columns: 1fr;
      padding: 3rem 2rem;
      gap: 3rem;
      text-align: center;
    }
  }

  .newsletter-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(37, 99, 235, 0.15);
    color: #93c5fd;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    padding: 0.6rem 1.2rem;
    border-radius: 100px;
    margin-bottom: 1.5rem;
    border: 1px solid rgba(37, 99, 235, 0.3);
  }

  .newsletter-heading {
    font-size: clamp(2.25rem, 4.5vw, 3rem);
    font-weight: 800;
    color: #ffffff;
    line-height: 1.05;
    margin: 0 0 1.5rem 0;
    letter-spacing: -0.03em;
  }

  .newsletter-subtext {
    font-size: 1.125rem;
    color: rgba(255, 255, 255, 0.7);
    line-height: 1.6;
    margin: 0;
    max-width: 500px;
  }

  .newsletter-form-container {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .iframe-wrapper {
    width: 100%;
    min-height: 380px; /* Adjust based on form height with recaptcha */
    position: relative;
  }

  .newsletter-iframe {
    width: 100%;
    height: 100%;
    min-height: 380px;
    border: none;
    background: transparent;
    color-scheme: dark;
  }

  .newsletter-disclaimer {
    margin-top: 1rem;
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.45);
    text-align: center;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }
</style>
