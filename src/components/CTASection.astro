---
import Button from './Button.astro';

interface Props {
  title?: string;
  text?: string;
}

const { 
  title = "Ready to Build Audit-Ready Proof?", 
  text = "Move from spreadsheets and disconnected documents to centralized compliance and policy management." 
} = Astro.props;
---

<section class="py-24 bg-proofyx-blue relative overflow-hidden">
  <div class="container mx-auto px-6 relative z-10 text-center">
    <h2 class="text-3xl md:text-4xl font-bold text-white mb-6 leading-tight">
      {title}
    </h2>
    <p class="text-white/90 text-lg mb-10 max-w-2xl mx-auto leading-relaxed">
      {text}
    </p>
    <div class="flex flex-wrap justify-center gap-4">
      <Button href="/#get-started" variant="secondary" size="lg">Get Started</Button>
      <Button href="https://compliance.proofyx.com" variant="outline" size="lg" class="!border-white !text-white hover:!bg-white/10">Launch Compliance App</Button>
      <Button href="https://policy.proofyx.com" variant="outline" size="lg" class="!border-white !text-white hover:!bg-white/10">Launch Policy App</Button>
    </div>
  </div>
  
  <!-- Subtle background pattern -->
  <div class="absolute top-0 left-0 w-full h-full opacity-10 pointer-events-none">
    <svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
          <path d="M 40 0 L 0 0 0 40" fill="none" stroke="white" stroke-width="1"/>
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#grid)" />
    </svg>
  </div>
</section>
