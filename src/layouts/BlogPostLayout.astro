---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import CTASection from '../components/CTASection.astro';
import BlogCard from '../components/BlogCard.astro';
import Button from '../components/Button.astro';
import Newsletter from '../components/Newsletter.astro';

const { frontmatter, slug, headings = [] } = Astro.props;
const { title, description, pubDate, category, readingTime, image, seoTitle, seoDescription } = frontmatter;

const tocHeadings = headings.filter(h => h.depth > 1 && h.depth < 4);

const allPosts = await getCollection('blog', ({ data }) => {
  return import.meta.env.DEV || !data.draft;
});
const relatedPosts = allPosts
  .filter(post => post.id !== slug)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const formattedDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(new Date(pubDate));

const canonicalShareURL = new URL(Astro.url.pathname, Astro.site).href;
---

<BaseLayout 
  title={title} 
  description={description} 
  seoTitle={seoTitle} 
  seoDescription={seoDescription}
  image={image?.src}
  ogType="article"
  headerTransparent={false}
  backgroundClass="bg-[#f8f9fb]"
>
  <!-- Coming Soon Overlay -->
  <div id="coming-soon-overlay" class="hidden fixed inset-0 z-[100] bg-[#0c1220]/95 backdrop-blur-md flex flex-col items-center justify-center text-center p-6">
    <div class="max-w-md">
      <div class="w-16 h-16 bg-blue-500/20 rounded-2xl flex items-center justify-center mx-auto mb-6 border border-blue-500/30">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#60a5fa" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
      </div>
      <h2 class="text-2xl font-bold text-white mb-3">Coming Soon</h2>
      <p class="text-slate-400 mb-8 leading-relaxed">
        Scheduled for <span class="font-semibold text-white">{formattedDate}</span>.
      </p>
      <Button href="/blog" variant="outline" class="!border-white/20 !text-white hover:!bg-white/10">Back to Blog</Button>
    </div>
  </div>

  <article 
    id="blog-content" 
    data-publish-date={new Date(pubDate).toISOString()}
    data-is-dev={import.meta.env.DEV}
    class="relative"
  >
    <!-- ═══════════════════════════════════════════
         HERO — Dark navy, full bleed
    ═══════════════════════════════════════════ -->
    <div class="relative bg-[#0c1220] overflow-hidden">
      <!-- Subtle radial glow top-left -->
      <div class="absolute -top-32 -left-32 w-[600px] h-[600px] bg-blue-600/10 rounded-full blur-[100px] pointer-events-none"></div>
      <div class="absolute -top-16 right-0 w-[400px] h-[400px] bg-indigo-600/8 rounded-full blur-[80px] pointer-events-none"></div>
      <!-- Fine dot grid -->
      <div class="absolute inset-0 opacity-[0.06]" style="background-image: radial-gradient(rgba(255,255,255,0.5) 1px, transparent 1px); background-size: 28px 28px;" aria-hidden="true"></div>

      <div class="container mx-auto px-6 pt-12 pb-20 md:pt-16 md:pb-28 relative z-10">
        <div class="max-w-3xl mx-auto">
          <!-- Breadcrumb -->
          <nav aria-label="Breadcrumb" class="mb-10">
            <ol class="flex items-center gap-2 text-xs text-slate-500 font-medium">
              <li><a href="/" class="hover:text-slate-300 transition-colors">Home</a></li>
              <li class="opacity-40">/</li>
              <li><a href="/blog" class="hover:text-slate-300 transition-colors">Blog</a></li>
              <li class="opacity-40">/</li>
              <li class="text-slate-400 truncate max-w-xs" aria-current="page">{title}</li>
            </ol>
          </nav>

          <!-- Meta row -->
          <div class="flex flex-wrap items-center gap-3 mb-7">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-blue-500/15 border border-blue-500/25 text-blue-300 text-xs font-semibold tracking-wide">
              {category}
            </span>
            <span class="text-slate-600">·</span>
            <time class="text-slate-500 text-sm" datetime={new Date(pubDate).toISOString()}>{formattedDate}</time>
            <span class="text-slate-600">·</span>
            <span class="text-slate-500 text-sm">{readingTime}</span>
          </div>

          <!-- Title -->
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-white leading-[1.08] tracking-tight mb-7">
            {title}
          </h1>

          <!-- Description / lede -->
          <p class="text-lg md:text-xl text-slate-400 leading-relaxed max-w-2xl font-normal">
            {description}
          </p>

          <!-- Share links -->
          <div class="flex items-center gap-3 mt-10 pt-8 border-t border-white/[0.07]">
            <span class="text-xs text-slate-600 font-semibold uppercase tracking-widest mr-1">Share</span>
            <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(canonicalShareURL)}`} target="_blank" rel="noopener noreferrer" aria-label="Share on LinkedIn"
              class="w-8 h-8 rounded-lg bg-white/5 border border-white/10 flex items-center justify-center text-slate-400 hover:text-white hover:bg-white/10 transition-all">
              <svg width="14" height="14" fill="currentColor" viewBox="0 0 24 24"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6zM2 9h4v12H2z"/><circle cx="4" cy="4" r="2"/></svg>
            </a>
            <a href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(canonicalShareURL)}&text=${encodeURIComponent(title)}`} target="_blank" rel="noopener noreferrer" aria-label="Share on X"
              class="w-8 h-8 rounded-lg bg-white/5 border border-white/10 flex items-center justify-center text-slate-400 hover:text-white hover:bg-white/10 transition-all">
              <svg width="14" height="14" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
            </a>
            <button id="copy-link-btn" data-url={canonicalShareURL} aria-label="Copy link"
              class="w-8 h-8 rounded-lg bg-white/5 border border-white/10 flex items-center justify-center text-slate-400 hover:text-white hover:bg-white/10 transition-all">
              <svg id="copy-icon" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
              <svg id="check-icon" class="hidden" width="14" height="14" fill="none" stroke="#4ade80" stroke-width="2.5" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- ═══════════════════════════════════════════
         HERO IMAGE — spans the transition zone
    ═══════════════════════════════════════════ -->
    {image && (
      <div class="bg-[#0c1220] pb-10">
        <div class="container mx-auto px-6">
          <div class="max-w-5xl mx-auto">
            <div class="rounded-2xl overflow-hidden shadow-[0_32px_64px_rgba(0,0,0,0.4)] border border-white/8">
              <Image
                src={image}
                alt={title}
                class="w-full aspect-[16/7] object-cover"
                loading="eager"
                fetchpriority="high"
              />
            </div>
          </div>
        </div>
      </div>
    )}

    <!-- ═══════════════════════════════════════════
         CONTENT AREA — White/light background
    ═══════════════════════════════════════════ -->
    <div class="bg-[#f8f9fb]">
      <div class="container mx-auto px-6 pt-10 pb-24">
        <div class="max-w-5xl mx-auto">
          <div class="grid lg:grid-cols-[1fr_280px] gap-12 xl:gap-16">

            <!-- Main Article Body -->
            <div class="min-w-0">
              <div class="bg-white rounded-2xl shadow-[0_2px_20px_rgba(0,0,0,0.06)] border border-slate-100 p-8 md:p-14">
                <div class="prose prose-slate prose-lg max-w-none
                  prose-headings:font-bold prose-headings:tracking-tight prose-headings:text-slate-900 prose-headings:scroll-mt-28
                  prose-h2:text-2xl prose-h2:mt-12 prose-h2:mb-4
                  prose-h3:text-xl prose-h3:mt-8 prose-h3:mb-3
                  prose-p:text-slate-700 prose-p:leading-[1.85] prose-p:font-normal
                  prose-a:text-blue-600 prose-a:no-underline prose-a:font-medium hover:prose-a:underline
                  prose-strong:text-slate-900 prose-strong:font-semibold
                  prose-blockquote:border-l-4 prose-blockquote:border-blue-500 prose-blockquote:bg-blue-50/60 prose-blockquote:rounded-r-xl prose-blockquote:py-4 prose-blockquote:px-6 prose-blockquote:not-italic prose-blockquote:text-slate-700
                  prose-code:text-blue-700 prose-code:bg-blue-50 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:font-mono prose-code:text-sm prose-code:before:content-none prose-code:after:content-none
                  prose-pre:bg-slate-900 prose-pre:rounded-xl prose-pre:shadow-md
                  prose-img:rounded-xl prose-img:shadow-md
                  prose-ul:text-slate-700 prose-ol:text-slate-700
                  prose-li:leading-relaxed">
                  <slot />
                </div>
              </div>

              <!-- In-article CTA -->
              <div class="mt-8 rounded-2xl bg-gradient-to-br from-[#0c1220] to-[#1a2744] p-10 border border-white/10 relative overflow-hidden">
                <div class="absolute -right-12 -bottom-12 w-48 h-48 bg-blue-500/15 rounded-full blur-3xl pointer-events-none"></div>
                <div class="relative z-10 flex flex-col sm:flex-row sm:items-center gap-8">
                  <div class="flex-1">
                    <h3 class="text-xl font-bold text-white mb-2">Build your audit-ready proof with Proofyx</h3>
                    <p class="text-slate-400 text-sm leading-relaxed">Automate evidence collection and policy management — always prepared for your next audit.</p>
                  </div>
                  <Button href="/#get-started" class="!rounded-xl !px-6 !py-3 shrink-0 shadow-lg shadow-blue-500/20">Get Started</Button>
                </div>
              </div>

              <!-- Author -->
              <div class="mt-8 bg-white rounded-2xl border border-slate-100 shadow-[0_2px_16px_rgba(0,0,0,0.05)] p-8">
                <div class="flex items-start gap-5">
                  <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-blue-600 to-indigo-700 flex items-center justify-center shrink-0 shadow-md">
                    <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                  </div>
                  <div>
                    <p class="font-bold text-slate-900 text-base">Proofyx Editorial Team</p>
                    <p class="text-blue-600 text-xs font-semibold uppercase tracking-wider mt-0.5 mb-2">Compliance Intelligence</p>
                    <p class="text-slate-500 text-sm leading-relaxed">Expert analysis and regulatory guidance for organizations navigating modern compliance frameworks.</p>
                  </div>
                </div>
              </div>
            </div>

            <!-- Sidebar -->
            <aside class="hidden lg:block space-y-6 sticky top-28 h-fit">
              <!-- Table of Contents -->
              {tocHeadings.length > 0 && (
                <div class="bg-white rounded-2xl border border-slate-100 shadow-[0_2px_16px_rgba(0,0,0,0.05)] p-6">
                  <h4 class="text-xs font-bold uppercase tracking-widest text-slate-400 mb-5 flex items-center gap-2">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/></svg>
                    In this article
                  </h4>
                  <nav>
                    <ul class="space-y-1">
                      {tocHeadings.map(h => (
                        <li class:list={[h.depth === 3 ? "pl-4" : ""]}>
                          <a 
                            href={`#${h.slug}`}
                            class:list={[
                              "block py-1.5 text-sm leading-snug transition-colors rounded-lg px-2 -mx-2",
                              h.depth === 3 ? "text-slate-400 hover:text-slate-700 text-xs" : "text-slate-600 hover:text-blue-600 font-medium"
                            ]}
                          >
                            {h.text}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </nav>
                </div>
              )}

              <!-- Sidebar CTA -->
              <div class="rounded-2xl bg-[#0c1220] border border-white/10 p-6 relative overflow-hidden">
                <div class="absolute -top-8 -right-8 w-32 h-32 bg-blue-500/15 rounded-full blur-2xl pointer-events-none"></div>
                <div class="relative z-10">
                  <div class="w-10 h-10 rounded-xl bg-blue-600 flex items-center justify-center mb-4 shadow-lg shadow-blue-500/30">
                    <svg width="18" height="18" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                  </div>
                  <h4 class="text-white font-bold text-base mb-2">Verify your Compliance</h4>
                  <p class="text-slate-400 text-sm leading-relaxed mb-5">Centralize your evidence and stay audit-ready with Proofyx.</p>
                  <Button href="/contact" size="sm" class="w-full !justify-center !rounded-xl">Get a Demo</Button>
                </div>
              </div>

              <!-- Post metadata card -->
              <div class="bg-white rounded-2xl border border-slate-100 p-6 space-y-4 shadow-[0_2px_16px_rgba(0,0,0,0.04)]">
                <div class="flex items-center justify-between text-sm">
                  <span class="text-slate-400 font-medium">Category</span>
                  <span class="text-slate-700 font-semibold">{category}</span>
                </div>
                <div class="h-px bg-slate-50"></div>
                <div class="flex items-center justify-between text-sm">
                  <span class="text-slate-400 font-medium">Published</span>
                  <span class="text-slate-700 font-semibold">{formattedDate}</span>
                </div>
                <div class="h-px bg-slate-50"></div>
                <div class="flex items-center justify-between text-sm">
                  <span class="text-slate-400 font-medium">Read time</span>
                  <span class="text-slate-700 font-semibold">{readingTime}</span>
                </div>
              </div>
            </aside>
          </div>
        </div>
      </div>
    </div>
  </article>

  <!-- Related Posts -->
  {relatedPosts.length > 0 && (
    <section class="py-20 bg-white border-t border-slate-100">
      <div class="container mx-auto px-6">
        <div class="max-w-5xl mx-auto">
          <div class="flex items-center justify-between mb-10">
            <div>
              <h2 class="text-2xl font-bold text-slate-900">Keep Reading</h2>
              <p class="text-slate-500 text-sm mt-1">More from the Proofyx compliance library.</p>
            </div>
            <Button href="/blog" variant="outline" class="!rounded-xl !px-5 !py-2.5 !text-sm !border-slate-200 !text-slate-600 hover:!border-blue-500 hover:!text-blue-600">All Posts →</Button>
          </div>
          <div class="grid md:grid-cols-3 gap-6">
            {relatedPosts.map(post => (
              <BlogCard 
                title={post.data.title}
                description={post.data.description}
                pubDate={post.data.pubDate}
                category={post.data.category}
                readingTime={post.data.readingTime}
                image={post.data.image}
                slug={post.id}
              />
            ))}
          </div>
        </div>
      </div>
    </section>
  )}

  <Newsletter
    heading="Compliance intelligence, straight to your inbox."
    subtext="Practical guides for CMMC, NIST, and SOC2 — delivered bi-weekly by the Proofyx team."
  />

  <CTASection />

  <script>
    function initBlogScripts() {
      const content = document.getElementById('blog-content');
      const overlay = document.getElementById('coming-soon-overlay');
      if (content && overlay) {
        const publishDate = new Date(content.dataset.publishDate || '');
        const isDev = content.dataset.isDev === 'true';
        if (!isDev && publishDate > new Date()) {
          overlay.classList.remove('hidden');
          document.body.style.overflow = 'hidden';
        } else {
          overlay.classList.add('hidden');
          document.body.style.overflow = '';
        }
      }

      const copyBtn = document.getElementById('copy-link-btn');
      const copyIcon = document.getElementById('copy-icon');
      const checkIcon = document.getElementById('check-icon');
      copyBtn?.addEventListener('click', async () => {
        const url = copyBtn.getAttribute('data-url');
        if (url) {
          try {
            await navigator.clipboard.writeText(url);
            copyIcon?.classList.add('hidden');
            checkIcon?.classList.remove('hidden');
            setTimeout(() => { copyIcon?.classList.remove('hidden'); checkIcon?.classList.add('hidden'); }, 2000);
          } catch {}
        }
      });
    }
    initBlogScripts();
    document.addEventListener('astro:after-swap', initBlogScripts);
  </script>
</BaseLayout>
