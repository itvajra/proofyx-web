---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import CTASection from '../components/CTASection.astro';
import BlogCard from '../components/BlogCard.astro';
import Button from '../components/Button.astro';

const { frontmatter, slug } = Astro.props;
const { title, description, pubDate, category, readingTime, image, seoTitle, seoDescription } = frontmatter;

const allPosts = await getCollection('blog');
const relatedPosts = allPosts
  .filter(post => post.id !== slug)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const formattedDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(new Date(pubDate));
---

<BaseLayout 
  title={title} 
  description={description} 
  seoTitle={seoTitle} 
  seoDescription={seoDescription}
>
  <article class="py-20">
    <div class="container mx-auto px-6 max-w-4xl">
      <div class="mb-8">
        <a href="/blog" class="inline-flex items-center gap-2 text-sm font-medium text-neutral-500 hover:text-proofyx-blue transition-colors group">
          <span class="group-hover:-translate-x-1 transition-transform">←</span> Back to Blog
        </a>
      </div>

      <div class="mb-12 text-center">
        <div class="inline-flex items-center gap-3 mb-6">
          <span class="text-xs font-bold uppercase tracking-wider text-proofyx-blue px-3 py-1.5 bg-proofyx-blue-light rounded">
            {category}
          </span>
          <span class="text-neutral-400 text-xs">•</span>
          <time class="text-neutral-500 text-sm">{formattedDate}</time>
          <span class="text-neutral-400 text-xs">•</span>
          <span class="text-neutral-500 text-sm">{readingTime}</span>
        </div>
        <h1 class="text-4xl md:text-5xl font-bold text-neutral-900 leading-tight mb-8">
          {title}
        </h1>
        <p class="text-xl text-neutral-600 leading-relaxed max-w-2xl mx-auto">
          {description}
        </p>
      </div>

      {image && (
        <div class="mb-16 rounded-2xl overflow-hidden border border-neutral-200 shadow-enterprise">
          <Image 
            src={image} 
            alt={title} 
            class="w-full aspect-[21/9] object-cover"
          />
        </div>
      )}

      <div class="prose prose-neutral max-w-none border-t border-neutral-200 pt-12">
        <slot />
      </div>

      <div class="mt-20 pt-10 border-t border-neutral-200">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 bg-neutral-200 rounded-full flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#42526E" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
            </div>
            <div>
              <p class="text-neutral-900 font-bold text-sm mb-0">Proofyx Editorial Team</p>
              <p class="text-neutral-500 text-xs uppercase tracking-widest">Compliance Experts</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </article>

  {relatedPosts.length > 0 && (
    <section class="py-20 bg-neutral-50 border-t border-neutral-200">
      <div class="container mx-auto px-6">
        <div class="flex items-center justify-between mb-10">
          <h2 class="text-2xl font-bold text-neutral-900">Latest Articles</h2>
          <Button href="/blog" variant="outline" size="sm">View All Articles</Button>
        </div>
        <div class="grid md:grid-cols-3 gap-8">
          {relatedPosts.map(post => (
            <BlogCard 
              title={post.data.title}
              description={post.data.description}
              pubDate={post.data.pubDate}
              category={post.data.category}
              readingTime={post.data.readingTime}
              image={post.data.image}
              slug={post.id}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  <CTASection />
</BaseLayout>
