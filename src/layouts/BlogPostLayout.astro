---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import CTASection from '../components/CTASection.astro';
import BlogCard from '../components/BlogCard.astro';
import Button from '../components/Button.astro';
import Newsletter from '../components/Newsletter.astro';

const { frontmatter, slug, headings = [] } = Astro.props;
const { title, description, pubDate, category, readingTime, image, seoTitle, seoDescription } = frontmatter;

// Filter for relevant headings (h2 and h3)
const tocHeadings = headings.filter(h => h.depth > 1 && h.depth < 4);

const allPosts = await getCollection('blog');
const relatedPosts = allPosts
  .filter(post => post.id !== slug)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const formattedDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(new Date(pubDate));

const canonicalShareURL = new URL(Astro.url.pathname, Astro.site).href;
---

<BaseLayout 
  title={title} 
  description={description} 
  seoTitle={seoTitle} 
  seoDescription={seoDescription}
  image={image?.src}
  ogType="article"
>
  <article class="py-12 md:py-20">
    <div class="container mx-auto px-6">
      <!-- Breadcrumbs -->
      <nav class="max-w-4xl mx-auto mb-12" aria-label="Breadcrumb">
        <ol class="flex items-center gap-2 text-sm font-medium">
          <li>
            <a href="/" class="text-neutral-500 hover:text-proofyx-blue transition-colors">Home</a>
          </li>
          <li class="text-neutral-400">/</li>
          <li>
            <a href="/blog" class="text-neutral-500 hover:text-proofyx-blue transition-colors">Blog</a>
          </li>
          <li class="text-neutral-400">/</li>
          <li class="text-neutral-900 truncate max-w-[200px] md:max-w-none" aria-current="page">
            {title}
          </li>
        </ol>
      </nav>

      <!-- Header Section -->
      <div class="max-w-4xl mx-auto mb-16 text-center">
        <div class="inline-flex items-center gap-3 mb-6">
          <span class="text-xs font-bold uppercase tracking-wider text-proofyx-blue px-3 py-1.5 bg-proofyx-blue-light rounded">
            {category}
          </span>
          <span class="text-neutral-400 text-xs" role="presentation">•</span>
          <time class="text-neutral-500 text-sm" datetime={new Date(pubDate).toISOString()}>{formattedDate}</time>
          <span class="text-neutral-400 text-xs" role="presentation">•</span>
          <span class="text-neutral-500 text-sm">{readingTime}</span>
        </div>
        <h1 class="text-4xl md:text-6xl font-bold text-neutral-900 leading-tight mb-8">
          {title}
        </h1>
        <p class="text-xl text-neutral-600 leading-relaxed max-w-2xl mx-auto italic">
          {description}
        </p>
      </div>

      {image && (
        <div class="max-w-5xl mx-auto mb-16 rounded-2xl overflow-hidden border border-neutral-200 shadow-enterprise">
          <Image 
            src={image} 
            alt={title} 
            class="w-full aspect-[21/9] object-cover"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      )}

      <!-- Article Grid -->
      <div class="max-w-6xl mx-auto grid lg:grid-cols-[1fr_280px] gap-16">
        <div class="min-w-0">
          <div class="prose prose-neutral max-w-none prose-lg prose-headings:scroll-mt-24">
            <slot />
          </div>

          <!-- In-Article CTA Callout -->
          <div class="my-16 p-8 rounded-2xl bg-proofyx-blue-light border border-proofyx-blue/10 relative overflow-hidden group">
            <div class="absolute -right-4 -bottom-4 text-9xl font-bold text-proofyx-blue/[0.03] pointer-events-none group-hover:scale-110 transition-transform">✓</div>
            <h3 class="text-2xl font-bold text-neutral-900 mb-4 relative z-10">Struggling with manual evidence collection?</h3>
            <p class="text-neutral-700 mb-6 relative z-10">Proofyx centralizes your evidence, policies, and compliance workflows so you're always audit-ready.</p>
            <Button href="/contact" variant="primary" class="relative z-10">Talk to an Expert</Button>
          </div>

          <!-- Author Box -->
          <div class="mt-20 pt-10 border-t border-neutral-200">
            <div class="flex items-center gap-6 p-8 bg-neutral-50 rounded-2xl border border-neutral-100">
              <div class="w-16 h-16 bg-neutral-200 rounded-full flex items-center justify-center shrink-0 border-4 border-white shadow-sm">
                <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#42526E" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
              </div>
              <div>
                <p class="text-neutral-900 font-bold text-lg mb-1">Proofyx Editorial Team</p>
                <p class="text-neutral-500 text-xs uppercase tracking-widest font-bold mb-3">Compliance & Audit Experts</p>
                <p class="text-sm text-neutral-600 leading-relaxed max-w-lg">Dedicated to demystifying complex compliance frameworks and providing actionable insights for regulated organizations.</p>
            </div>
          </div>
        </div>

          <!-- Share Section -->
          <div class="mt-12 flex items-center gap-4">
            <span class="text-sm font-bold text-neutral-600 uppercase tracking-widest">Share:</span>
            <div class="flex gap-2">
              <a 
                href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(canonicalShareURL)}`} 
                target="_blank" 
                rel="noopener noreferrer"
                class="w-10 h-10 rounded-full border border-neutral-200 flex items-center justify-center text-neutral-600 hover:border-proofyx-blue hover:text-proofyx-blue transition-all"
                aria-label="Share on LinkedIn"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>
              </a>
              <a 
                href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(canonicalShareURL)}&text=${encodeURIComponent(title)}`} 
                target="_blank" 
                rel="noopener noreferrer"
                class="w-10 h-10 rounded-full border border-neutral-200 flex items-center justify-center text-neutral-600 hover:border-proofyx-blue hover:text-proofyx-blue transition-all"
                aria-label="Share on Twitter"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"></path></svg>
              </a>
              <a 
                href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(canonicalShareURL)}`} 
                target="_blank" 
                rel="noopener noreferrer"
                class="w-10 h-10 rounded-full border border-neutral-200 flex items-center justify-center text-neutral-600 hover:border-proofyx-blue hover:text-proofyx-blue transition-all"
                aria-label="Share on Facebook"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
              </a>
              <button 
                id="copy-link-btn"
                data-url={canonicalShareURL}
                class="w-10 h-10 rounded-full border border-neutral-200 flex items-center justify-center text-neutral-600 hover:border-proofyx-blue hover:text-proofyx-blue transition-all"
                aria-label="Copy link"
              >
                <svg id="copy-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>
                <svg id="check-icon" class="hidden text-proofyx-green" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
              </button>
            </div>
          </div>

          <script>
            function initCopyBtn() {
              const copyBtn = document.getElementById('copy-link-btn');
              const copyIcon = document.getElementById('copy-icon');
              const checkIcon = document.getElementById('check-icon');

              copyBtn?.addEventListener('click', async () => {
                const url = copyBtn.getAttribute('data-url');
                if (url) {
                  try {
                    await navigator.clipboard.writeText(url);
                    copyIcon?.classList.add('hidden');
                    checkIcon?.classList.remove('hidden');
                    setTimeout(() => {
                      copyIcon?.classList.remove('hidden');
                      checkIcon?.classList.add('hidden');
                    }, 2000);
                  } catch (err) {
                    console.error('Failed to copy: ', err);
                  }
                }
              });
            }

            initCopyBtn();
            document.addEventListener('astro:after-swap', initCopyBtn);
          </script>
        </div> <!-- End of min-w-0 -->

        <!-- Sidebar -->
        <aside class="hidden lg:block space-y-12 sticky top-32 h-fit">
          {tocHeadings.length > 0 && (
            <div class="p-6 bg-white rounded-xl border border-neutral-100 shadow-sm">
              <h4 class="text-xs font-bold uppercase tracking-widest text-neutral-600 mb-6">Table of Contents</h4>
              <nav>
                <ul class="space-y-4">
                  {tocHeadings.map(h => (
                    <li class:list={[
                      "text-sm transition-colors",
                      h.depth === 3 ? "pl-4" : ""
                    ]}>
                      <a 
                        href={`#${h.slug}`} 
                        class="text-neutral-600 hover:text-proofyx-blue font-medium block leading-tight"
                      >
                        {h.text}
                      </a>
                    </li>
                  ))}
                </ul>
              </nav>
            </div>
          )}

          <div class="p-8 bg-neutral-50 rounded-2xl border-2 border-proofyx-blue/10 shadow-sm relative overflow-hidden group hover:border-proofyx-blue/30 transition-colors">
            <div class="absolute -right-8 -top-8 w-24 h-24 bg-proofyx-blue/5 rounded-full"></div>
            <h4 class="text-xl font-bold mb-4 relative z-10 text-proofyx-blue">Audit Readiness Assessment</h4>
            <p class="text-neutral-600 text-sm mb-6 relative z-10 leading-relaxed font-medium">Know where you stand before the assessor arrives. Schedule a demo of our platform today.</p>
            <Button href="/contact" size="sm" class="w-full justify-center relative z-10">Book a Demo</Button>
          </div>
        </aside>
      </div>
    </div>
  </article>

  {relatedPosts.length > 0 && (
    <section class="py-20 bg-neutral-50 border-t border-neutral-200">
      <div class="container mx-auto px-6">
        <div class="flex items-center justify-between mb-10">
          <h2 class="text-2xl font-bold text-neutral-900">Related Articles</h2>
          <Button href="/blog" variant="outline" size="sm">View All Articles</Button>
        </div>
        <div class="grid md:grid-cols-3 gap-8">
          {relatedPosts.map(post => (
            <BlogCard 
              title={post.data.title}
              description={post.data.description}
              pubDate={post.data.pubDate}
              category={post.data.category}
              readingTime={post.data.readingTime}
              image={post.data.image}
              slug={post.id}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- 
  <div class="container mx-auto px-6 py-20">
    <Newsletter />
  </div>
  -->

  <CTASection />
</BaseLayout>
