---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  seoTitle?: string;
  seoDescription?: string;
  image?: string;
  canonicalURL?: string;
  ogType?: string;
}

const { 
  title, 
  description = "Proofyx is an enterprise compliance proof platform focused on audit-ready evidence and policy lifecycle management.",
  seoTitle,
  seoDescription,
  image = "/og-image.png",
  canonicalURL = Astro.url.href,
  ogType = "website"
} = Astro.props;

const metaTitle = seoTitle || `${title} | Proofyx`;
const metaDescription = seoDescription || description;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <title>{metaTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:title" content={metaTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:image" content={new URL(image, Astro.url)} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url.href} />
    <meta property="twitter:title" content={metaTitle} />
    <meta property="twitter:description" content={metaDescription} />
    <meta property="twitter:image" content={new URL(image, Astro.url)} />
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[200] focus:bg-white focus:text-proofyx-blue focus:px-4 focus:py-2 focus:rounded-md focus:shadow-lg focus:outline-none focus:ring-2 focus:ring-proofyx-blue font-bold">Skip to content</a>
    <Header />
    <main id="main-content" class="flex-grow outline-none" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
